// TerragenUE.ush - glue between Terragen.ush and Unreal: rendering the skybox cross atlas (layout in
// Terragen.ush, the same as Scripts/GenerateSkyboxTexture.py, so a rendered atlas matches the old
// Textures/MountainTop crosses pixel for pixel) and coordinate conversion. Like Terragen.ush, this file also
// compiles as C++ for the test harness.

#ifndef TERRAGEN_UE_USH
#define TERRAGEN_UE_USH

#include "Terragen.ush"

// The atlas layout and lookups (TGAtlasFace, TG_AtlasDirection, TG_AtlasUV, TG_AtlasLookup) are in Terragen.ush.

// A camera following the player can end up below the Terragen ground, where every ray starts inside the
// terrain. Inside the grid, lift it to at least Clearance units above the ground (or the water) under it.
// A negative Clearance leaves the position alone.
float3 TG_KeepAboveTerrain(TGWorld W, Texture2D HeightTex, float3 P, float Clearance)
{
	float n = (float)W.Terrain.Cells;
	if (Clearance < 0.0 || P.x < 0.0 || P.y < 0.0 || P.x > n || P.y > n)
	{
		return P;
	}
	float ground = TG_TerrainHeight(HeightTex, W.Terrain, P.x, P.y);
	if (W.WaterPresent != 0.0)
	{
		ground = max(ground, W.WaterLevel);
	}
	return float3(P.x, P.y, max(P.z, ground + Clearance));
}

// Render one atlas texel. Returns display colour (Terragen tone curve applied) and alpha (0 = sky or
// outside the faces). Write it to an 8-bit linear (non-sRGB) target to get Terragen's bytes exactly.
// CloudTex is the world's cloud map from Tools/make_cloud_map.py; it is only read when the sky is on.
float4 TG_RenderAtlasTexel(TGWorld W, Texture2D HeightTex, Texture2D NoiseTex, Texture2D CloudTex, float2 UV, float3 CameraPos, float AtlasHeading, float FaceSize, float StartDistance, float Clearance)
{
	float4 d = TG_AtlasDirection(UV, AtlasHeading, FaceSize);
	if (d.w == 0.0)
	{
		return float4(0.0, 0.0, 0.0, 0.0);
	}
	float3 eye = TG_KeepAboveTerrain(W, HeightTex, CameraPos, Clearance);
	return TG_RenderRay(W, HeightTex, NoiseTex, CloudTex, eye, float3(d.x, d.y, d.z), 2.0 / FaceSize, StartDistance);
}

// ---------------------------------------------------------------- split rendering
// The sky changes slowly with the camera and is the costly part (clouds), so ATerragenSkybox renders it into
// its own, smaller atlas and redraws it rarely. The terrain pass skips the sky of rays that miss the terrain
// and fills them from that sky atlas instead, so its atlas is still the whole picture. The sky water reflects
// is costly too; it can come from a third atlas (Mode 1 of the sky pass), or be computed exactly per texel.

// Sky pass: the sky seen along an atlas texel's direction, ignoring terrain (always alpha 1 inside the faces).
float4 TG_RenderAtlasTexelSky(TGWorld W, Texture2D HeightTex, Texture2D CloudTex, float2 UV, float3 CameraPos, float AtlasHeading, float FaceSize, float Clearance)
{
	float4 d = TG_AtlasDirection(UV, AtlasHeading, FaceSize);
	if (d.w == 0.0)
	{
		return float4(0.0, 0.0, 0.0, 0.0);
	}
	float3 eye = TG_KeepAboveTerrain(W, HeightTex, CameraPos, Clearance);
	return TG_RenderSkyRay(W, CloudTex, eye, float3(d.x, d.y, d.z), 2.0 / FaceSize);
}

// The sky pass's quality settings: CloudQuality scales the cloud samples, AtmosQuality the number of atmosphere
// steps (1 = the world's own for both). Terragen's atmosphere accuracy (ATAC) sets the cloud-shadow grid
// spacing too, and the shadow lookups follow the grid, so a coarser step alone would save little. Both scale
// together, as one ATAC step lower does for 0.5. (A world whose spacing isn't the step, like the pre-sky
// MountainTop, keeps its spacing.)
TGWorld TG_SkyQuality(TGWorld W, float CloudQuality, float AtmosQuality)
{
	W.Sky.CloudSamples = max(1.0, floor(W.Sky.CloudSamples * CloudQuality + 0.5));
	float step = W.Atmos.Step / max(AtmosQuality, 0.05);
	W.CloudFade = W.CloudFade == W.Atmos.Step ? step : W.CloudFade;
	W.Atmos.Step = step;
	return W;
}

// The sky pass as ATerragenSkybox draws it now. Mode 0: the sky, except directions where the terrain or water
// hides it from anywhere near the camera (TG_SkyHidden), which are left black: the terrain pass never reads
// them. Mode 1: the sky water reflections see (TG_RenderReflectionSkyRay), linear, for a floating-point atlas.
float4 TG_RenderAtlasTexelSky(TGWorld W, Texture2D HeightTex, Texture2D CloudTex, float2 UV, float3 CameraPos, float AtlasHeading, float FaceSize, float StartDistance, float Clearance, float Mode)
{
	float4 d = TG_AtlasDirection(UV, AtlasHeading, FaceSize);
	if (d.w == 0.0)
	{
		return float4(0.0, 0.0, 0.0, 0.0);
	}
	float3 eye = TG_KeepAboveTerrain(W, HeightTex, CameraPos, Clearance);
	float3 dir = float3(d.x, d.y, d.z);
	if (Mode != 0.0)
	{
		return TG_RenderReflectionSkyRay(W, CloudTex, eye, dir);
	}
	if (TG_SkyHidden(W, eye, dir, StartDistance))
	{
		return float4(0.0, 0.0, 0.0, 1.0);
	}
	return TG_RenderSkyRay(W, CloudTex, eye, dir, 2.0 / FaceSize);
}

// ---------------------------------------------------------------- projections
// The terrain atlas (the one the sky sphere shows) can be laid out two ways. Projection 0: the cube cross, 4 x 4
// faces of FaceSize. Projection 1: a sphere map (TG_SphereDirection), 4 * FaceSize wide and 2 * FaceSize tall,
// so the same FaceSize setting gives the same width. The sky and reflection atlases are always cube crosses;
// they are only looked up by direction.

// View direction for an atlas UV; w = 0 outside the cube faces.
float4 TG_ProjectionDirection(float2 UV, float AtlasHeading, float FaceSize, float Projection)
{
	if (Projection != 0.0)
	{
		float3 d = TG_SphereDirection(UV, AtlasHeading);
		return float4(d.x, d.y, d.z, 1.0);
	}
	return TG_AtlasDirection(UV, AtlasHeading, FaceSize);
}

// The angle one atlas pixel spans, for the detail footprint: at a cube face's centre, or along the sphere
// map's columns.
float TG_ProjectionPixelAngle(float FaceSize, float Projection)
{
	return Projection != 0.0 ? 1.5707963 / FaceSize : 2.0 / FaceSize;
}

// Atlas UV for a view direction, the inverse of TG_ProjectionDirection.
float2 TG_ProjectionUV(float3 Dir, float AtlasHeading, float FaceSize, float Projection)
{
	return Projection != 0.0 ? TG_SphereUV(Dir, AtlasHeading) : TG_AtlasUV(Dir, AtlasHeading, FaceSize);
}

// Terrain pass: like TG_RenderAtlasTexel, but a ray that hits nothing returns alpha 0 without computing the sky.
// With ReflFaceSize > 0, water reflections read their sky from ReflSky, a Mode 1 sky atlas with faces of that
// size drawn with the camera at ReflCameraPos (see TG_ShadeRayEx); 0 computes it exactly.
float4 TG_RenderAtlasTexelTerrain(TGWorld W, Texture2D HeightTex, Texture2D NoiseTex, Texture2D CloudTex, Texture2D ReflSky, float2 UV, float3 CameraPos, float3 ReflCameraPos, float AtlasHeading, float FaceSize, float ReflFaceSize, float StartDistance, float Clearance, float Projection)
{
	float4 d = TG_ProjectionDirection(UV, AtlasHeading, FaceSize, Projection);
	if (d.w == 0.0)
	{
		return float4(0.0, 0.0, 0.0, 0.0);
	}
	float3 eye = TG_KeepAboveTerrain(W, HeightTex, CameraPos, Clearance);
	TGShadeResult R = TG_ShadeRayEx(W, HeightTex, NoiseTex, CloudTex, eye, float3(d.x, d.y, d.z), TG_ProjectionPixelAngle(FaceSize, Projection),
	                                StartDistance, true, ReflSky, ReflCameraPos, AtlasHeading, ReflFaceSize);
	float3 c = TG_ToneMap(W, R.Linear);
	return float4(c.x, c.y, c.z, R.Alpha);
}

float4 TG_RenderAtlasTexelTerrain(TGWorld W, Texture2D HeightTex, Texture2D NoiseTex, Texture2D CloudTex, Texture2D ReflSky, float2 UV, float3 CameraPos, float3 ReflCameraPos, float AtlasHeading, float FaceSize, float ReflFaceSize, float StartDistance, float Clearance)
{
	return TG_RenderAtlasTexelTerrain(W, HeightTex, NoiseTex, CloudTex, ReflSky, UV, CameraPos, ReflCameraPos, AtlasHeading, FaceSize, ReflFaceSize, StartDistance, Clearance, 0.0);
}

float4 TG_RenderAtlasTexelTerrain(TGWorld W, Texture2D HeightTex, Texture2D NoiseTex, Texture2D CloudTex, float2 UV, float3 CameraPos, float AtlasHeading, float FaceSize, float StartDistance, float Clearance)
{
	return TG_RenderAtlasTexelTerrain(W, HeightTex, NoiseTex, CloudTex, NoiseTex, UV, CameraPos, CameraPos, AtlasHeading, FaceSize, 0.0, StartDistance, Clearance, 0.0);
}

// The terrain pass plus the sky atlas: where the terrain pass found no terrain, look the direction up in the
// sky atlas (a cube cross with faces of SkyFaceSize, same heading). Returns the display colour, alpha 1.
// ReflSky, ReflCameraPos and ReflFaceSize are the reflection-sky atlas, as for TG_RenderAtlasTexelTerrain;
// Projection is the terrain atlas's layout.
float4 TG_RenderAtlasTexelComposite(TGWorld W, Texture2D HeightTex, Texture2D NoiseTex, Texture2D CloudTex, Texture2D SkyAtlas, SamplerState SkySampler, Texture2D ReflSky, float2 UV, float3 CameraPos, float3 ReflCameraPos, float AtlasHeading, float FaceSize, float SkyFaceSize, float ReflFaceSize, float StartDistance, float Clearance, float Projection)
{
	float4 t = TG_RenderAtlasTexelTerrain(W, HeightTex, NoiseTex, CloudTex, ReflSky, UV, CameraPos, ReflCameraPos, AtlasHeading, FaceSize, ReflFaceSize, StartDistance, Clearance, Projection);
	if (t.w == 0.0)
	{
		float4 d = TG_ProjectionDirection(UV, AtlasHeading, FaceSize, Projection);
		if (d.w != 0.0)
		{
			float2 s = TG_AtlasUV(float3(d.x, d.y, d.z), AtlasHeading, SkyFaceSize);
			float4 sky = SkyAtlas.SampleLevel(SkySampler, s, 0.0);
			t = float4(sky.x, sky.y, sky.z, 1.0);
		}
	}
	return t;
}

// The cube cross only: the signature of the materials made before the sphere map.
float4 TG_RenderAtlasTexelComposite(TGWorld W, Texture2D HeightTex, Texture2D NoiseTex, Texture2D CloudTex, Texture2D SkyAtlas, SamplerState SkySampler, Texture2D ReflSky, float2 UV, float3 CameraPos, float3 ReflCameraPos, float AtlasHeading, float FaceSize, float SkyFaceSize, float ReflFaceSize, float StartDistance, float Clearance)
{
	return TG_RenderAtlasTexelComposite(W, HeightTex, NoiseTex, CloudTex, SkyAtlas, SkySampler, ReflSky, UV, CameraPos, ReflCameraPos, AtlasHeading, FaceSize, SkyFaceSize, ReflFaceSize, StartDistance, Clearance, 0.0);
}

// Without the reflection atlas (reflections exact): the signature of the first split materials.
float4 TG_RenderAtlasTexelComposite(TGWorld W, Texture2D HeightTex, Texture2D NoiseTex, Texture2D CloudTex, Texture2D SkyAtlas, SamplerState SkySampler, float2 UV, float3 CameraPos, float AtlasHeading, float FaceSize, float SkyFaceSize, float StartDistance, float Clearance)
{
	return TG_RenderAtlasTexelComposite(W, HeightTex, NoiseTex, CloudTex, SkyAtlas, SkySampler, NoiseTex, UV, CameraPos, CameraPos, AtlasHeading, FaceSize, SkyFaceSize, 0.0, StartDistance, Clearance, 0.0);
}

// The signature M_TerragenRender was created with (no cloud map). Only for worlds where the cloud map is
// never read: sky off and clouds not casting shadows, like MountainTop. NoiseTex just fills the slot.
float4 TG_RenderAtlasTexel(TGWorld W, Texture2D HeightTex, Texture2D NoiseTex, float2 UV, float3 CameraPos, float AtlasHeading, float FaceSize, float StartDistance, float Clearance)
{
	return TG_RenderAtlasTexel(W, HeightTex, NoiseTex, NoiseTex, UV, CameraPos, AtlasHeading, FaceSize, StartDistance, Clearance);
}

// Unreal (X forward, Y right, Z up) to Terragen (x right, y forward at heading 0, z up). HeadingAtPlusX is
// the Terragen heading seen when looking along Unreal's +X.
float3 TG_FromUEDirection(float3 UE, float HeadingAtPlusX)
{
	float h = HeadingAtPlusX * TG_DEG;
	float x = UE.y;
	float y = UE.x;
	return float3(x * cos(h) + y * sin(h), -x * sin(h) + y * cos(h), UE.z);
}

// The atlas stores display values; decoding them as sRGB gives what sampling the old sRGB skybox textures did.
float3 TG_SRGBToLinear(float3 c)
{
	float r = c.x <= 0.04045 ? c.x / 12.92 : pow(abs((c.x + 0.055) / 1.055), 2.4);
	float g = c.y <= 0.04045 ? c.y / 12.92 : pow(abs((c.y + 0.055) / 1.055), 2.4);
	float b = c.z <= 0.04045 ? c.z / 12.92 : pow(abs((c.z + 0.055) / 1.055), 2.4);
	return float3(r, g, b);
}

#endif // TERRAGEN_UE_USH
