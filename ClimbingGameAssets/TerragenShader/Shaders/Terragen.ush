// Terragen.ush - Terragen 0.9.43's terrain renderer, rebuilt as HLSL functions.
//
// The maths follows the decompiled Terragen.dll (addresses below refer to the unpacked DLL).
// Terragen rasterises micro-polygons; here each pixel ray-marches the same surface instead, which
// finds the same visible point. Everything after visibility (surface layers, bump, light, shadows,
// tone curve) uses Terragen's own formulas and constants.
//
// Coordinates are Terragen's: x and y in grid points (0..Cells), z in terrain units, where one unit is
// also one grid step (scale_m metres, from the .ter). +z is up; heading 0 looks along +y, 90 along +x.
//
// Also covered: the atmosphere (haze, blue and red layers with the sunlight penetration table), the sky
// dome with the sun disc and the cloud layer and its shadows (cloud map from Tools/make_cloud_map.py), and
// water with waves, reflection, the sun's reflection and the bed seen through it. Not ported: surf.
//
// This file is also compiled as C++ by Tests/tg_render.cpp (through Tests/hlsl_shim.h), so it sticks
// to a shared subset: no swizzles, no out/inout parameters, float literals written as floats. Include
// guards rather than #pragma once, which FXC (D3D11 SM5) doesn't understand.

#ifndef TERRAGEN_USH
#define TERRAGEN_USH

#ifndef TG_LOOP
#define TG_LOOP [loop]
#endif

// Profiling switches (Tools/ue_profile.py sets them through a Custom node's Additional Defines); all off by
// default, which is the renderer as described here.
#ifndef TG_PROFILE_NO_WAVES
#define TG_PROFILE_NO_WAVES 0        // flat water normal (no wave turbulence)
#endif
#ifndef TG_PROFILE_WATER_TRACES
#define TG_PROFILE_WATER_TRACES 3    // 1: no reflection or bed; 2: reflection but no bed
#endif
#ifndef TG_PROFILE_NO_REFL_SKY
#define TG_PROFILE_NO_REFL_SKY 0     // reflections that miss the terrain show nothing
#endif

// FXC warns (X3557) when it can tell that a [loop] runs once for the world compiled in, such as the water's
// extra traces in a world with flat water. That is expected; the loops keep one copy of each big function.
#if !defined(__cplusplus) && !defined(__HLSL_VERSION)
#pragma warning(disable : 3557)
#endif

#define TG_MAX_LAYERS 8
#define TG_MAX_DEPTH 4
#define TG_MAX_LEVELS 24
#define TG_MAX_ATMOS_STEPS 4096

#include "TerragenPerlin.ush"

static const float TG_DEG = 0.0174532925;

struct TGTerrain
{
	int Cells;            // grid cells per side (points - 1); must be a power of two
	int CellsLog2;
	float BaseHeight;     // .ter ALTW BaseHeight
	float HeightScale;    // .ter ALTW HeightScale
	float MinHeight;      // lowest and highest elevation, for ray bounds and shadow early-outs
	float MaxHeight;
	float PlanetRadius;   // in grid units; 0 = flat (Terragen curves the terrain when the .ter asks)
};

// One surface layer (Terragen's "surface map" tree). Layer 0 is the root; Parent indexes another layer.
// Layers are listed depth first, so children always come after their parent.
struct TGLayer
{
	int Parent;
	float3 Colour;        // DIFC / 256
	float BumpAmount;     // BMAM
	float BumpTerrainMod; // MTER
	float2 BumpOrigin;    // BMTX/SETT ORIG
	float BumpNegate;     // BMTX/SETT NEGA
	float BumpIsol;       // BMTX/SETT ISOL
	float BumpVari;       // BMTX/SETT VARI
	float HasNoise;       // 1 when the layer has fractal-noise breakup (DENS/VART)
	float2 NoiseOrigin;   // DENS/VART/SETT ORIG
	float Variation;      // DENS VARI
	float Coverage;       // COVR
	float2 AltEnable;     // ALTE (min, max)
	float2 AltLimit;      // ALTL, terrain units
	float2 AltFuzz;       // ALTF
	float2 SlopeEnable;   // SLPE
	float2 SlopeLimit;    // SLPL, tan(angle)
	float2 SlopeFuzz;     // SLPF
	float SmallestSize;   // SMSZ
};

// The three atmosphere layers (GHAZ) as ReceiveRender (0x1002b1f0) prepares them. A layer whose Length is
// 0 is off. Densities fall as 2^(-h / Half); Length is the distance over which density 1 halves light.
struct TGAtmosphere
{
	float On;             // any layer present
	float LutOn;          // sunlight is filtered by the atmosphere (penetration table, 0x10019b50)
	float3 HazeColour;    // HCOL / 256
	float3 BlueColour;    // BCOL / 256
	float3 RedColour;     // RCOL / 256: per-channel light decay
	float HazeLength;
	float BlueLength;
	float RedLength;
	float HazeHalf;       // half heights, terrain units
	float BlueHalf;
	float RedHalf;
	float Top;            // 6 * the largest half height, at least the cloud altitude
	float Step;           // view-ray march step: (7680 / scale) / 2^ATAC
	float LutStep;        // penetration table: an eighth of the smallest active half height
	float LutBottom;      // minus the terrain size
	float LutCount;       // entries - 1
	float SunChord;       // sunlight path through one table shell
	float PlanetRadius;   // atmosphere heights are measured above the curved sea level
	float GlowAmount;     // GLOA
	float GlowPower;      // GLOP
	float GlowFlag;       // land and atmosphere shadows both on: unsaturated glow
};

// The sky dome and cloud layer (CLDL; cloud object layout from the CloudLayer* exports).
struct TGSky
{
	float On;             // RSKY and a cloud layer
	float Corona;         // sun disc edge falloff, 1 / CORS^2; 0 = hard edge
	float DomeRadius;     // 32 * terrain size
	float CloudN;         // cloud map cells per side (512)
	float CloudExtent;    // CSIZ, terrain units
	float CloudCell;      // CSIZ / N
	float CloudContrast;  // CONT
	float CloudBias;      // BIAS
	float CloudMethod;    // REME: 0 cloud map, 1 marched
	float CloudNoiseAmp;  // detail noise amplitude left by the map generator
	float CloudDarkness;  // CDRK
	float CloudSteps;     // 2^CLAC
	float CloudStepsMax;  // 4 * 2^CLAC
	float CloudNoiseLimit;// 2^(CLAC - 8)
	float CloudSamples;   // samples the shader takes along a march that Terragen does in 16 * steps
};

struct TGWorld
{
	TGTerrain Terrain;
	float Detail;               // LDET
	float SunHeading;           // degrees
	float SunAltitude;          // degrees
	float SunDiameter;          // degrees
	float3 SunColour;           // light colour * strength, linear
	float LandShadows;          // LCST
	float3 Ambient;             // "single colour" background light
	float3 AmbientUp;           // "multi-directional" terms
	float3 AmbientAway;
	float3 AmbientSun;
	float CloudsPresent;
	float CloudAltitude;        // terrain units
	float CloudDepth;
	float CloudSunlight;        // sunlight left under the cloud layer when clouds don't cast real shadows
	float CloudFade;            // the dimming fades in over this height around the cloud altitude; also the
	                            // cloud shadow grid spacing (the DLL uses the atmosphere step, see tgw_to_ush.py)
	float CloudShadows;         // CCST: clouds cast real shadows (TG_CloudShadow)
	float WaterPresent;
	float WaterLevel;
	float3 WaterColour;
	int ToneMode;               // EXME: 0 gamma, 1 film, 2 smooth film
	float Gamma;                // GAMA
	float Exposure;             // multiplies linear colour before the tone curve
	float BumpTerrainValue;     // stand-in for a per-point map the bump amplitude reads (see TG_BumpAmplitude)
	float3 BackgroundColour;    // shown where no terrain, water or sky is hit
	float WaterShading;         // 1 Terragen's water (TG_WaterSurface); 0 the flat lit plane of the pre-sky renderer
	float WaterWaveSize;        // WLEN, terrain units
	float WaterWaveAmp;         // WAMP * WLEN
	float WaterWaveTime;        // third wave-noise coordinate: (frame / 24) / WLEN / scale
	float WaterViscosity;       // VISC * WAMP: pulls the reflection cosine towards 1
	float WaterReflMin;         // MINR: reflectivity looking straight down
	float WaterReflMax;         // MAXR: reflectivity at grazing angles
	float WaterReflCurve;       // RCRV
	float WaterSunLobe;         // RSLB: sun reflection strength
	float WaterSunWidth;        // RSLS: sun reflection width, radians
	float3 WaterAbsorb;         // per terrain unit, from TRNC * TRNS
	float WaterMaxDepth;        // the bed shows through up to this far below the surface, terrain units
	TGAtmosphere Atmos;
	TGSky Sky;
	int NumLayers;
	TGLayer Layers[TG_MAX_LAYERS];
};

struct TGSunInfo
{
	float3 Dir;      // towards the sun
	float SinHead;
	float CosHead;
	float SinAlt;
	float TanLow;    // tangent of the altitude of the sun disc's lower edge
	float TanHigh;   // ... and its upper edge
};

struct TGHit
{
	int Kind;        // 0 none, 1 terrain, 2 water
	float T;         // ray parameter (distance when the direction is normalised)
	float3 P;
};

struct TGShadeResult
{
	float3 Linear;   // radiance before exposure and tone curve
	float Alpha;     // 1 where terrain or water was hit
	float3 Albedo;   // surface colour from the layer tree
	float SunTerm;   // sunlight factor: cloud dimming * (1 - shadow) * max(N.L, 0)
	float NdotL;     // shading normal against the sun direction
	float NormalZ;   // shading normal's up component
	float Distance;  // along the ray, in grid units
	int Kind;
};

// ---------------------------------------------------------------- heightfield

float TG_GridHeight(Texture2D HeightTex, TGTerrain T, int x, int y)
{
	x = clamp(x, 0, T.Cells);
	y = clamp(y, 0, T.Cells);
	float texel = floor(HeightTex.Load(int3(x, y, 0)).x * 65535.0 + 0.5);
	float h = T.BaseHeight + (texel - 32768.0) * T.HeightScale / 65536.0;
	if (T.PlanetRadius > 0.0)
	{
		// ReceiveRender (0x1002b1f0): h -= R - sqrt(R^2 - d^2), d measured from the grid centre.
		float dx = (float)(x - T.Cells / 2);
		float dy = (float)(y - T.Cells / 2);
		h -= T.PlanetRadius - sqrt(T.PlanetRadius * T.PlanetRadius - (dx * dx + dy * dy));
	}
	return h;
}

// Two triangles per cell, split on the (1,0)-(0,1) diagonal (0x10032940).
float TG_TerrainHeight(Texture2D HeightTex, TGTerrain T, float x, float y)
{
	int ix = clamp((int)floor(x), 0, T.Cells - 1);
	int iy = clamp((int)floor(y), 0, T.Cells - 1);
	float fx = x - (float)ix;
	float fy = y - (float)iy;
	float h10 = TG_GridHeight(HeightTex, T, ix + 1, iy);
	float h01 = TG_GridHeight(HeightTex, T, ix, iy + 1);
	float h = 0.0;
	if (fx + fy > 1.0)
	{
		float h11 = TG_GridHeight(HeightTex, T, ix + 1, iy + 1);
		h = (1.0 - fy) * (h10 - h11) + (1.0 - fx) * (h01 - h11) + h11;
	}
	else
	{
		float h00 = TG_GridHeight(HeightTex, T, ix, iy);
		h = h00 + (h10 - h00) * fx + (h01 - h00) * fy;
	}
	return h;
}

// ---------------------------------------------------------------- noise

// (2^k * a) mod 128, keeping precision when 2^k * a is far beyond float's exact range.
float TG_Pow2Mod128(float a, int k)
{
	float ia = floor(a);
	float fa = a - ia;
	float im = 0.0;
	if (k < 0)
	{
		float period = 128.0 * exp2((float)(-k));
		im = (ia - period * floor(ia / period)) * exp2((float)k);
	}
	else if (k < 7)
	{
		im = (float)((((int)(ia - 128.0 * floor(ia / 128.0))) << k) & 127);
	}
	float fm = fa * exp2((float)k);
	return im + fm - 128.0 * floor(fm / 128.0);
}

// Coordinate of one noise octave: 2^kp * p + 2^ko * o, wrapped to the 128-point lattice.
float TG_OctaveCoord(float p, int kp, float o, int ko)
{
	float c = TG_Pow2Mod128(p, kp) + TG_Pow2Mod128(o, ko);
	return c - 128.0 * floor(c / 128.0);
}

float TG_Lattice(Texture2D NoiseTex, int x, int y)
{
	return floor(NoiseTex.Load(int3(x & 127, y & 127, 0)).x * 65535.0 + 0.5) / 32767.0 - 0.5;
}

// Value noise with smoothstep interpolation, period 128 (0x1001fc30).
float TG_Noise(Texture2D NoiseTex, float x, float y)
{
	float x0 = floor(x);
	float y0 = floor(y);
	int ix = (int)x0;
	int iy = (int)y0;
	float fx = x - x0;
	float fy = y - y0;
	float sx = (3.0 - 2.0 * fx) * fx * fx;
	float sy = (3.0 - 2.0 * fy) * fy * fy;
	float a = lerp(TG_Lattice(NoiseTex, ix, iy), TG_Lattice(NoiseTex, ix + 1, iy), sx);
	float b = lerp(TG_Lattice(NoiseTex, ix, iy + 1), TG_Lattice(NoiseTex, ix + 1, iy + 1), sx);
	return lerp(a, b, sy);
}

// GradxNoise / GradyNoise (0x100201f0, 0x10020240): central differences with eps 0.005.
float2 TG_NoiseGradient(Texture2D NoiseTex, float x, float y)
{
	float gx = (TG_Noise(NoiseTex, x + 0.005, y) - TG_Noise(NoiseTex, x - 0.005, y)) * 100.0;
	float gy = (TG_Noise(NoiseTex, x, y + 0.005) - TG_Noise(NoiseTex, x, y - 0.005)) * 100.0;
	return float2(gx, gy);
}

// Fractal sum of equal-amplitude octaves (0x10020290). Octave i samples 2^(kp+i) * p + 2^(ko+i) * o;
// the octave count is trunc(log2(Limit) + 0.01) + 1.
float TG_Fractal(Texture2D NoiseTex, float2 p, int kp, float2 o, int ko, float Limit)
{
	if (Limit <= 0.0)
	{
		return 0.0;
	}
	int n = min((int)(log2(Limit) + 0.01), 30);
	float sum = 0.0;
	TG_LOOP for (int i = 0; i <= n; i++)
	{
		sum += TG_Noise(NoiseTex, TG_OctaveCoord(p.x, kp + i, o.x, ko + i), TG_OctaveCoord(p.y, kp + i, o.y, ko + i));
	}
	return sum;
}

uint TG_Pcg(uint v)
{
	uint state = v * 747796405u + 2891336453u;
	uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
	return (word >> 22u) ^ word;
}

// White noise in [0, 1) from a position; stands in for Terragen's hashed table (0x1001eb50).
float TG_Hash01(float x, float y, uint seed)
{
	uint qx = (uint)(int)floor(x * 4096.0);
	uint qy = (uint)(int)floor(y * 4096.0);
	return (float)(TG_Pcg(qx ^ TG_Pcg(qy ^ TG_Pcg(seed))) & 0xFFFFFFu) / 16777216.0;
}

// ---------------------------------------------------------------- surface layers

float TG_Sigmoid(float v)
{
	return 1.0 / (exp(-clamp(v, -100.0, 100.0)) + 1.0);
}

// Soft penalty outside one limit: -exp(distance past the limit / fuzz), or a hard cut when fuzz <= 0.
float TG_LimitPenalty(float value, float limit, float fuzz, bool isMax)
{
	float past = isMax ? value - limit : limit - value;
	if (fuzz <= 0.0)
	{
		return past > 0.0 ? -10000.0 : 0.0;
	}
	return -exp(min(past / fuzz, 80.0));
}

// Layer coverage (0x10026a20). Returns (coverage, detail size used to pick the next bump level).
float2 TG_Coverage(TGLayer Ly, Texture2D NoiseTex, int CellsLog2, float2 p, float h, float2 grad, float footprint)
{
	// The slope measure is |gradient| = tan(slope angle), the unit SLPL is stored in.
	float slope = sqrt(grad.x * grad.x + grad.y * grad.y);
	float pen = 0.0;
	if (Ly.AltEnable.x != 0.0)   { pen += TG_LimitPenalty(h, Ly.AltLimit.x, Ly.AltFuzz.x, false); }
	if (Ly.AltEnable.y != 0.0)   { pen += TG_LimitPenalty(h, Ly.AltLimit.y, Ly.AltFuzz.y, true); }
	if (Ly.SlopeEnable.x != 0.0) { pen += TG_LimitPenalty(slope, Ly.SlopeLimit.x, Ly.SlopeFuzz.x, false); }
	if (Ly.SlopeEnable.y != 0.0) { pen += TG_LimitPenalty(slope, Ly.SlopeLimit.y, Ly.SlopeFuzz.y, true); }

	float noise = 0.0;
	if (Ly.HasNoise != 0.0)
	{
		// Noise coordinates are position / terrain size + origin; octaves stop at a quarter footprint.
		float limit = 4.0 * exp2((float)CellsLog2) / footprint;
		noise = TG_Fractal(NoiseTex, p, -CellsLog2, Ly.NoiseOrigin, 0, limit) * Ly.Variation;
	}
	float base = (Ly.HasNoise * Ly.Variation + 1.0) * (Ly.Coverage + pen - 0.5);
	float cov = TG_Sigmoid((noise + 2.0 * base) * 4.0);
	float detail = cov >= 1.0 - exp(-4.0) ? Ly.SmallestSize : log(1.0 - cov) * Ly.SmallestSize * -0.25;
	return float2(cov, detail);
}

// Bump amplitude (0x10025d70). Terragen scales it by ((m - 0.25) * MTER + 0.25), where m comes from a
// per-point map in the heightfield object that hasn't been identified; World.BumpTerrainValue stands in.
float TG_BumpAmplitude(TGWorld W, TGLayer Ly, Texture2D NoiseTex, float2 p, float footprint)
{
	float amp = ((W.BumpTerrainValue - 0.25) * Ly.BumpTerrainMod + 0.25) * Ly.BumpAmount;
	float limit = 1.0 / footprint;
	if (Ly.BumpIsol != 0.0)
	{
		float f = TG_Fractal(NoiseTex, p, 0, Ly.BumpOrigin, 0, limit);
		amp *= 2.0 * TG_Sigmoid((f * Ly.BumpIsol + 0.125) * 4.0);
	}
	if (Ly.BumpVari > 0.0)
	{
		float f = TG_Fractal(NoiseTex, p, 0, Ly.BumpOrigin + float2(20.0, 30.0), 0, limit);
		amp *= 2.0 * TG_Sigmoid((f * Ly.BumpVari + 0.125) * 4.0);
	}
	return Ly.BumpNegate != 0.0 ? -amp : amp;
}

// Bump gradient of one level: level k samples noise at frequency 2^(k-4) per grid step.
float2 TG_BumpOctave(Texture2D NoiseTex, TGLayer Ly, float2 p, int k, float amp)
{
	float cx = TG_OctaveCoord(p.x, k - 4, Ly.BumpOrigin.x, k - 4);
	float cy = TG_OctaveCoord(p.y, k - 4, Ly.BumpOrigin.y, k - 4);
	return TG_NoiseGradient(NoiseTex, cx, cy) * amp;
}

struct TGSurface
{
	float3 Colour;
	float2 Grad;     // terrain gradient plus bump, in height units per grid step
};

// The surface-layer tree (0x10026370), evaluated without recursion. Each layer adds its own bump octaves
// to a copy of its parent's per-level gradients, starting at a level chosen from its coverage detail;
// the result is blended back into the parent by the layer's coverage.
TGSurface TG_SurfaceTree(TGWorld W, Texture2D HeightTex, Texture2D NoiseTex, float x, float y, float2 grad0, float footprint)
{
	// Coverage and bump are sampled at a point jittered by up to one footprint, as Terragen does.
	float2 pj = float2(x + TG_Hash01(x, y, 1u) * footprint, y + TG_Hash01(x, y, 2u) * footprint);
	float hj = TG_TerrainHeight(HeightTex, W.Terrain, pj.x, pj.y);
	int levels = clamp(max(4, (int)(log2(1.0 / footprint) + 0.01) + 6), 4, TG_MAX_LEVELS - 1);

	float2 G[TG_MAX_DEPTH][TG_MAX_LEVELS];
	float3 C[TG_MAX_DEPTH];
	float Cov[TG_MAX_DEPTH];
	int Node[TG_MAX_DEPTH];
	int Next[TG_MAX_DEPTH];
	int Level[TG_MAX_DEPTH];

	TG_LOOP for (int k0 = 0; k0 <= levels; k0++)
	{
		G[0][k0] = grad0;
	}
	C[0] = W.Layers[0].Colour;
	Cov[0] = 1.0;
	Node[0] = 0;
	Next[0] = 1;
	Level[0] = 4;
	int d = 0;
	bool pushed = true;

	TG_LOOP for (int iter = 0; iter < 2 * TG_MAX_LAYERS + 2; iter++)
	{
		if (pushed)
		{
			// Apply this layer's bump, starting at its level Lb (blend weights from 0x10025d70 with t = 0).
			TGLayer Ly = W.Layers[Node[d]];
			int lb = Level[d];
			if (Ly.BumpAmount != 0.0 && lb - 2 <= levels)
			{
				float amp = TG_BumpAmplitude(W, Ly, NoiseTex, pj, footprint);
				TG_LOOP for (int k = lb - 2; k <= levels; k++)
				{
					float2 n = TG_BumpOctave(NoiseTex, Ly, pj, k, amp);
					float2 prev = G[d][max(k - 1, 0)];
					if (k == lb - 2)      { G[d][k] = G[d][k] * 0.8 + (n + prev) * 0.2; }
					else if (k == lb - 1) { G[d][k] = G[d][k] * 0.4 + (n + prev) * 0.6; }
					else                  { G[d][k] = n + prev; }
				}
			}
			pushed = false;
		}

		int child = -1;
		TG_LOOP for (int j = Next[d]; j < W.NumLayers; j++)
		{
			if (W.Layers[j].Parent == Node[d])
			{
				child = j;
				break;
			}
		}

		if (child >= 0)
		{
			Next[d] = child + 1;
			if (d + 1 >= TG_MAX_DEPTH)
			{
				continue;
			}
			TGLayer Cl = W.Layers[child];
			// First pass at a coarse footprint picks which gradient level the slope test sees.
			float coarse = min(max(footprint, Cl.SmallestSize), 1.0);
			int lvl = clamp((int)log2(1.1 / coarse) + 4, 4, levels);
			float2 c1 = TG_Coverage(Cl, NoiseTex, W.Terrain.CellsLog2, pj, hj, G[d][lvl], coarse);
			int lvl2 = c1.y <= 0.0 ? levels : clamp((int)log2(1.1 / c1.y) + 4, 4, levels);
			float2 c2 = TG_Coverage(Cl, NoiseTex, W.Terrain.CellsLog2, pj, hj, G[d][lvl2], footprint);
			int childLevel = c2.y <= 0.0 ? levels + 4 : clamp((int)log2(1.1 / c2.y) + 4, 4, levels + 4);

			TG_LOOP for (int k1 = 0; k1 <= levels; k1++)
			{
				G[d + 1][k1] = G[d][k1];
			}
			d = d + 1;
			Node[d] = child;
			Next[d] = child + 1;
			Cov[d] = c2.x;
			C[d] = Cl.Colour;
			Level[d] = childLevel;
			pushed = true;
		}
		else
		{
			if (d == 0)
			{
				break;
			}
			float c = Cov[d];
			C[d - 1] = lerp(C[d - 1], C[d], c);
			TG_LOOP for (int k2 = 0; k2 <= levels; k2++)
			{
				G[d - 1][k2] = lerp(G[d - 1][k2], G[d][k2], c);
			}
			d = d - 1;
		}
	}

	TGSurface S;
	S.Colour = C[0];
	S.Grad = G[0][levels];
	return S;
}

// ---------------------------------------------------------------- light and shadow

TGSunInfo TG_MakeSun(TGWorld W)
{
	float head = W.SunHeading * TG_DEG;
	float alt = W.SunAltitude * TG_DEG;
	float r = W.SunDiameter * 0.008726646;   // ReceiveLighting (0x1002ada0): radius = diameter * pi / 360
	TGSunInfo S;
	S.SinHead = sin(head);
	S.CosHead = cos(head);
	S.SinAlt = sin(alt);
	S.Dir = float3(cos(alt) * S.SinHead, cos(alt) * S.CosHead, S.SinAlt);
	S.TanLow = tan(alt - r);
	S.TanHigh = tan(alt + r);
	return S;
}

// Soft terrain shadow (0x1002cc50): march grid line by grid line towards the sun with rays aimed at the
// lower and upper edge of the sun disc. Returns 0 (lit) .. 1 (fully hidden).
float TG_SunShadow(Texture2D HeightTex, TGTerrain T, TGSunInfo S, float x, float y, float h)
{
	if (S.SinAlt > 0.9999)
	{
		return 0.0;
	}
	bool yMajor = abs(S.SinHead) <= abs(S.CosHead);
	float major = yMajor ? S.CosHead : S.SinHead;
	float minorStep = yMajor ? S.SinHead / S.CosHead : S.CosHead / S.SinHead;
	float lowStep = S.TanLow / abs(major);
	float highStep = S.TanHigh / abs(major);
	float dir = major >= 0.0 ? 1.0 : -1.0;
	float a = yMajor ? y : x;
	float b = yMajor ? x : y;
	float n = (float)T.Cells;

	float dt = major >= 0.0 ? floor(a) + 1.0 - a : a - floor(a);
	a += dir * dt;
	b += dir * dt * minorStep;
	float zLow = h + dt * lowStep;
	float zHigh = h + dt * highStep;
	float s = 0.0;
	TG_LOOP for (int i = 0; i <= T.Cells + 1; i++)
	{
		if (a < 0.0 || a > n || b < 0.0 || b > n)
		{
			break;
		}
		if ((lowStep > 0.0 && zLow > T.MaxHeight) || (highStep < 0.0 && zHigh < T.MinHeight))
		{
			break;
		}
		float H = yMajor ? TG_TerrainHeight(HeightTex, T, b, a) : TG_TerrainHeight(HeightTex, T, a, b);
		if (zLow < H)
		{
			if (zHigh < H)
			{
				return 1.0;
			}
			s = max(s, (H - zLow) / (zHigh - zLow));
		}
		a += dir;
		b += dir * minorStep;
		zLow += lowStep;
		zHigh += highStep;
	}
	return s;
}

// Light at a point (0x1001b710 with 0x1002d2a0): the sun through a smoothstepped shadow, plus a constant
// ambient and three wrap-around ambient terms (sun side, away side, sky above). sunLight is the sun colour
// times its atmosphere transmittance, cloud dimming, shadow and N.L.
float3 TG_Light(TGWorld W, TGSunInfo S, float3 N, float3 sunLight)
{
	float ndl = dot(N, S.Dir);
	float wrapSun = max((ndl + 1.0) * 0.5, 0.0);
	float wrapAway = max((1.0 - ndl) * 0.5, 0.0);
	float wrapUp = max((N.z + 1.0) * 0.5, 0.0);
	return sunLight + W.AmbientSun * wrapSun + W.AmbientAway * wrapAway + W.AmbientUp * wrapUp + W.Ambient;
}

// ---------------------------------------------------------------- Perlin noise (cloud detail)

float TG_SCurve(float t)
{
	return t * t * (3.0 - 2.0 * t);
}

// noise2 (0x10020d30): Perlin's reference noise with truncation instead of the +N offset.
float TG_PerlinNoise2(float x, float y)
{
	int ix = (int)x;
	int iy = (int)y;
	float rx0 = x - (float)ix;
	float ry0 = y - (float)iy;
	float rx1 = rx0 - 1.0;
	float ry1 = ry0 - 1.0;
	int bx0 = ix & 255;
	int bx1 = (bx0 + 1) & 255;
	int by0 = iy & 255;
	int by1 = (by0 + 1) & 255;
	float sx = TG_SCurve(rx0);
	float sy = TG_SCurve(ry0);
	float2 q00 = TG_PerlinG2[TG_PerlinP[TG_PerlinP[bx0] + by0]];
	float2 q10 = TG_PerlinG2[TG_PerlinP[TG_PerlinP[bx1] + by0]];
	float2 q01 = TG_PerlinG2[TG_PerlinP[TG_PerlinP[bx0] + by1]];
	float2 q11 = TG_PerlinG2[TG_PerlinP[TG_PerlinP[bx1] + by1]];
	float a = lerp(rx0 * q00.x + ry0 * q00.y, rx1 * q10.x + ry0 * q10.y, sx);
	float b = lerp(rx0 * q01.x + ry1 * q01.y, rx1 * q11.x + ry1 * q11.y, sx);
	return lerp(a, b, sy);
}

float TG_PerlinDot3(int bx, int by, int bz, float rx, float ry, float rz)
{
	float3 g = TG_PerlinG3[TG_PerlinP[TG_PerlinP[TG_PerlinP[bx] + by] + bz]];
	return rx * g.x + ry * g.y + rz * g.z;
}

// noise3 (0x10020e80): as noise2, hashing p[p[p[x] + y] + z].
float TG_PerlinNoise3(float x, float y, float z)
{
	int ix = (int)x;
	int iy = (int)y;
	int iz = (int)z;
	float rx0 = x - (float)ix;
	float ry0 = y - (float)iy;
	float rz0 = z - (float)iz;
	float rx1 = rx0 - 1.0;
	float ry1 = ry0 - 1.0;
	float rz1 = rz0 - 1.0;
	int bx0 = ix & 255;
	int bx1 = (bx0 + 1) & 255;
	int by0 = iy & 255;
	int by1 = (by0 + 1) & 255;
	int bz0 = iz & 255;
	int bz1 = (bz0 + 1) & 255;
	float sx = TG_SCurve(rx0);
	float sy = TG_SCurve(ry0);
	float sz = TG_SCurve(rz0);
	float a = lerp(TG_PerlinDot3(bx0, by0, bz0, rx0, ry0, rz0), TG_PerlinDot3(bx1, by0, bz0, rx1, ry0, rz0), sx);
	float b = lerp(TG_PerlinDot3(bx0, by1, bz0, rx0, ry1, rz0), TG_PerlinDot3(bx1, by1, bz0, rx1, ry1, rz0), sx);
	float c = lerp(a, b, sy);
	a = lerp(TG_PerlinDot3(bx0, by0, bz1, rx0, ry0, rz1), TG_PerlinDot3(bx1, by0, bz1, rx1, ry0, rz1), sx);
	b = lerp(TG_PerlinDot3(bx0, by1, bz1, rx0, ry1, rz1), TG_PerlinDot3(bx1, by1, bz1, rx1, ry1, rz1), sx);
	return lerp(c, lerp(a, b, sy), sz);
}

// Turbulence (0x10020b00): lacunarity 1.7, offset 0.225, octave weights 1/sqrt(frequency).
float TG_Turbulence(float x, float y, float limit)
{
	float sum = 0.0;
	if (limit < 1.0)
	{
		return sum;
	}
	float f = 1.0;
	TG_LOOP for (int i = 0; i < 32 && f <= limit; i++)
	{
		sum += (abs(TG_PerlinNoise2(x * f, y * f)) - 0.225) / sqrt(f);
		f *= 1.7;
	}
	return sum;
}

// fBm (0x10020b90) on noise2, octave weights 1/frequency.
float TG_Fbm2(float x, float y, float limit)
{
	float sum = 0.0;
	if (limit < 1.0)
	{
		return sum;
	}
	float f = 1.0;
	TG_LOOP for (int i = 0; i < 32 && f <= limit; i++)
	{
		sum += TG_PerlinNoise2(x * f, y * f) / f;
		f *= 1.7;
	}
	return sum;
}

// Turbulence (0x10020c10) on noise3, octave weights 1/frequency; Terragen's water waves.
float TG_Turbulence3(float x, float y, float z, float limit)
{
	float sum = 0.0;
	if (limit < 1.0)
	{
		return sum;
	}
	float f = 1.0;
	TG_LOOP for (int i = 0; i < 32 && f <= limit; i++)
	{
		sum += (abs(TG_PerlinNoise3(x * f, y * f, z * f)) - 0.225) / f;
		f *= 1.7;
	}
	return sum;
}

// fBm (0x10020ca0) on noise3, octave weights 1/sqrt(frequency).
float TG_Fbm3(float x, float y, float z, float limit)
{
	float sum = 0.0;
	if (limit < 1.0)
	{
		return sum;
	}
	float f = 1.0;
	TG_LOOP for (int i = 0; i < 32 && f <= limit; i++)
	{
		sum += TG_PerlinNoise3(x * f, y * f, z * f) / sqrt(f);
		f *= 1.7;
	}
	return sum;
}

// ---------------------------------------------------------------- clouds and sky

float TG_CloudTexel(Texture2D CloudTex, int x, int y)
{
	return floor(CloudTex.Load(int3(x, y, 0)).x * 255.0 + 0.5) - 128.0;
}

// Cloud map value at map coordinates, two triangles per cell like the terrain.
float TG_CloudMapBase(Texture2D CloudTex, float u, float v)
{
	int ix = (int)u;
	int iy = (int)v;
	float fx = u - (float)ix;
	float fy = v - (float)iy;
	float m10 = TG_CloudTexel(CloudTex, ix + 1, iy);
	float m01 = TG_CloudTexel(CloudTex, ix, iy + 1);
	float m = 0.0;
	if (fx + fy > 1.0)
	{
		float m11 = TG_CloudTexel(CloudTex, ix + 1, iy + 1);
		m = (1.0 - fy) * (m10 - m11) + (1.0 - fx) * (m01 - m11) + m11;
	}
	else
	{
		float m00 = TG_CloudTexel(CloudTex, ix, iy);
		m = m00 + (m10 - m00) * fx + (m01 - m00) * fy;
	}
	return m;
}

// Cloud density (0x1001cd40): the map plus turbulence detail; 0 off the map.
float TG_CloudDensity(TGWorld W, Texture2D CloudTex, float u, float v, float limit)
{
	float top = W.Sky.CloudN - 0.001;
	if (u < 0.0 || v < 0.0 || u > top || v > top)
	{
		return 0.0;
	}
	float d = TG_CloudMapBase(CloudTex, u, v);
	if (W.Sky.CloudNoiseAmp != 0.0)
	{
		d += TG_Turbulence(u * 2.0, v * 2.0, limit) * W.Sky.CloudNoiseAmp;
	}
	return d;
}

struct TGCloudMarch
{
	float Tau;       // optical thickness
	float3 Hit;      // first point with density (u, v, z)
	float HasHit;
};

// Cloud march (0x1001d020). Terragen takes steps of 1/steps along dir (u, v in map cells, z in units) for up
// to 16 * steps iterations, while z stays short of the slab face it heads for. view = 1 is the view/light
// march: only points inside the slab count, |z| < (density + offset) * depth / 256, with the density there
// (0x1001cec0) the map plus 3D detail; Terragen's downward branch never runs, so rays looking down see no
// marched cloud. view = 0 sums the map along the path.
// The shader takes Sky.CloudSamples segments of the path. z is linear along a segment, so the number of its
// iterations that pass the z tests is exact; (u, v) are taken at the segment's middle.
TGCloudMarch TG_CloudMarch(TGWorld W, Texture2D CloudTex, float u, float v, float z, float footprint, float3 dir,
                           float steps, float limit, float view)
{
	TGCloudMarch M;
	M.Tau = 0.0;
	M.Hit = float3(0.0, 0.0, 0.0);
	M.HasHit = 0.0;
	steps = max(steps, 1.0);
	float step = 1.0 / steps;
	float iterations = 16.0 * steps;
	float samples = min(W.Sky.CloudSamples, iterations);
	float stride = iterations / samples;
	float halfDepth = W.CloudDepth * 0.5;
	float off = W.Sky.CloudBias;
	if (W.Sky.CloudNoiseAmp != 0.0)
	{
		off += TG_Fbm2(u * 2.0, v * 2.0, 0.5 / footprint) * W.Sky.CloudNoiseAmp * footprint * 4.0;
	}
	// The march continues while z < zHi (heading up) or z > zLo (heading down).
	float zLo = -1e30;
	float zHi = 1e30;
	if (dir.z > 0.0)
	{
		zHi = halfDepth;
	}
	else
	{
		zLo = view != 0.0 ? halfDepth : -halfDepth;
	}
	float sum = 0.0;
	TG_LOOP for (int k = 0; k < (int)samples; k++)
	{
		float a = (float)k * stride;
		float za = z + dir.z * step * a;
		float zb = za + dir.z * step * stride;
		bool running = dir.z > 0.0 ? za < zHi : za > zLo;
		float ua = u + dir.x * step * a;
		float va = v + dir.y * step * a;
		if (!running || (int)ua < 0 || (int)va < 0 || (int)ua >= (int)W.Sky.CloudN || (int)va >= (int)W.Sky.CloudN)
		{
			break;
		}
		float su = ua + dir.x * step * stride * 0.5;
		float sv = va + dir.y * step * stride * 0.5;
		float lo = max(min(za, zb), zLo);
		float hi = min(max(za, zb), zHi);
		float d = 0.0;
		if (view != 0.0)
		{
			float H = (TG_CloudDensity(W, CloudTex, su, sv, limit) + off) * W.CloudDepth * 0.00390625;
			lo = max(lo, -H);
			hi = min(hi, H);
			if (hi >= lo)
			{
				float base = TG_CloudMapBase(CloudTex, su, sv);
				if (W.Sky.CloudNoiseAmp != 0.0)
				{
					base += TG_Fbm3(su * 2.0, sv * 2.0, (lo + hi) * 1.0, limit) * W.Sky.CloudNoiseAmp;
				}
				d = max(base, -off) + off;
			}
		}
		else
		{
			d = TG_CloudDensity(W, CloudTex, su, sv, W.Sky.CloudSteps) + W.Sky.CloudBias;
		}
		float span = abs(zb - za);
		float frac = span > 1e-6 ? saturate((hi - lo) / span) : (hi >= lo ? 1.0 : 0.0);
		if (view != 0.0 && M.HasHit == 0.0 && d > 0.0 && frac > 0.0)
		{
			float ze = dir.z >= 0.0 ? lo : hi;
			float ie = a + (span > 1e-6 ? stride * abs(ze - za) / span : 0.0);
			M.Hit = float3(u + dir.x * step * ie, v + dir.y * step * ie, ze);
			M.HasHit = 1.0;
		}
		sum += d * stride * frac;
	}
	M.Tau = max(sum * W.Sky.CloudContrast * step, 0.0);
	return M;
}

// Cloud shadow grid node (0x1001c560): sunlight transmittance through the cloud column at node (i, j). Nodes
// are CloudFade apart; off the map they hold the uniform CloudSunlight. slant is 1 / sin(sun altitude).
float TG_CloudShadowNode(TGWorld W, Texture2D CloudTex, int i, int j, float slant)
{
	float g = W.CloudFade / W.Sky.CloudCell;
	float u = (float)i * g;
	float v = (float)j * g;
	if (u < 0.0 || v < 0.0 || u >= W.Sky.CloudN || v >= W.Sky.CloudN)
	{
		return W.CloudSunlight;
	}
	float d = max((TG_CloudDensity(W, CloudTex, u, v, 1.0) + W.Sky.CloudBias) * W.Sky.CloudContrast, 0.0);
	return pow(0.99, d * W.CloudDepth * slant);
}

// Cloud shadow (0x1001be60) where the sun ray from p (at height h) crosses the cloud altitude: the grid
// nodes blended with smoothstep weights. For a segment p0-p1 it averages 1 + floor(4 * length in nodes)
// lookups (at most 64) spread along it, as the atmosphere march does.
float TG_CloudShadow(TGWorld W, Texture2D CloudTex, TGSunInfo S, float3 p0, float h0, float3 p1, float h1)
{
	float margin = (W.Sky.CloudExtent - (float)W.Terrain.Cells) * 0.5;
	float g = W.CloudFade / W.Sky.CloudCell;
	float sx = S.Dir.x / S.Dir.z;
	float sy = S.Dir.y / S.Dir.z;
	float gu0 = ((margin + p0.x + (W.CloudAltitude - h0) * sx) / W.Sky.CloudCell) / g;
	float gv0 = ((margin + p0.y + (W.CloudAltitude - h0) * sy) / W.Sky.CloudCell) / g;
	float gu1 = ((margin + p1.x + (W.CloudAltitude - h1) * sx) / W.Sky.CloudCell) / g;
	float gv1 = ((margin + p1.y + (W.CloudAltitude - h1) * sy) / W.Sky.CloudCell) / g;
	float slant = sqrt(sx * sx + sy * sy + 1.0);
	int n = 1;
	if (p0.x != p1.x || p0.y != p1.y || h0 != h1)
	{
		n = min(1 + (int)floor(4.0 * sqrt((gu1 - gu0) * (gu1 - gu0) + (gv1 - gv0) * (gv1 - gv0))), 64);
	}
	float du = (gu1 - gu0) / (float)n;
	float dv = (gv1 - gv0) / (float)n;
	float su = gu0 + du * 0.5;
	float sv = gv0 + dv * 0.5;
	float sum = 0.0;
	TG_LOOP for (int k = 0; k < n; k++)
	{
		int i = (int)floor(su);
		int j = (int)floor(sv);
		float fx = su - (float)i;
		float fy = sv - (float)j;
		float wx = (3.0 - 2.0 * fx) * fx * fx;
		float wy = (3.0 - 2.0 * fy) * fy * fy;
		// The four nodes in a loop, so the node lookup is compiled once.
		TG_LOOP for (int c = 0; c < 4; c++)
		{
			int di = c == 1 || c == 3 ? 1 : 0;
			int dj = c >= 2 ? 1 : 0;
			float weight = (di == 1 ? wx : 1.0 - wx) * (dj == 1 ? wy : 1.0 - wy);
			sum += TG_CloudShadowNode(W, CloudTex, i + di, j + dj, slant) * weight;
		}
		su += du;
		sv += dv;
	}
	return sum / (float)n;
}

// Cloud dimming of the sun at a point, or along a segment of the atmosphere march (0x1001a100). Below the
// cloud layer it fades in over CloudFade around the cloud altitude (h is the atmosphere height when the
// atmosphere is on). Without "clouds cast shadows" the dimming is uniform; with it, it is the cloud shadow.
float TG_CloudSunFactor(TGWorld W, Texture2D CloudTex, TGSunInfo S, float3 p0, float h0, float3 p1, float h1)
{
	if (W.CloudsPresent == 0.0 || W.CloudFade <= 0.0)
	{
		return 1.0;
	}
	float w = saturate((W.CloudAltitude - 0.5 * (h0 + h1)) / W.CloudFade + 0.5);
	float T = W.CloudSunlight;
	if (W.CloudShadows != 0.0 && w > 0.0)
	{
		T = S.Dir.z > 0.0 ? TG_CloudShadow(W, CloudTex, S, p0, h0, p1, h1) : 0.0;
	}
	return 1.0 - (1.0 - T) * w;
}

// ---------------------------------------------------------------- atmosphere

// Height used by the atmosphere (0x10029b80): above the curved sea level, whatever the terrain's curvature.
float TG_AtmosHeight(TGWorld W, float3 p)
{
	float R = W.Atmos.PlanetRadius;
	float dx = p.x - (float)W.Terrain.Cells * 0.5;
	float dy = p.y - (float)W.Terrain.Cells * 0.5;
	return p.z + (R - sqrt(max(R * R - (dx * dx + dy * dy), 0.0)));
}

// 1 - 2^-x, accurate for small x.
float TG_OneMinusExp2Neg(float x)
{
	return x < 0.001 ? x * 0.693147181 * (1.0 - 0.346573590 * x) : 1.0 - exp2(-x);
}

// Penetration table (0x10019b50) in closed form. Entry i holds the sunlight transmittance through the table
// shells above it: each shell j (height LutBottom + j * LutStep) multiplies by RCOL^(2^(-h/RH) * c/L_red)
// and 0.5^(2^(-h/HH) * c/L_haze), with h clamped at -64 half heights. This returns, for one layer, the sum
// over shells j > i of 2^(-max(h_j, -64 Half) / Half).
float TG_ShellSum(TGAtmosphere A, float Half, int i)
{
	int n = (int)A.LutCount;
	int j0 = i + 1;
	if (j0 > n)
	{
		return 0.0;
	}
	float s = A.LutStep;
	float b = A.LutBottom;
	float sum = 0.0;
	int jc = (int)ceil((-64.0 * Half - b) / s);  // first shell above the clamp
	if (j0 < jc)
	{
		int clamped = min(jc, n + 1) - j0;
		sum += (float)clamped * 18446744073709551616.0;  // 2^64
		j0 = jc;
	}
	if (j0 <= n)
	{
		float x = s / Half;
		float first = exp2(-((float)j0 * s + b) / Half);
		sum += first * TG_OneMinusExp2Neg(x * (float)(n - j0 + 1)) / TG_OneMinusExp2Neg(x);
	}
	return sum;
}

float3 TG_LutEntry(TGAtmosphere A, int i)
{
	float3 logT = float3(0.0, 0.0, 0.0);
	if (A.RedLength > 0.0)
	{
		float k = TG_ShellSum(A, A.RedHalf, i) * A.SunChord / A.RedLength;
		logT = float3(A.RedColour.x > 0.0 ? log(A.RedColour.x) * k : -1e30,
		              A.RedColour.y > 0.0 ? log(A.RedColour.y) * k : -1e30,
		              A.RedColour.z > 0.0 ? log(A.RedColour.z) * k : -1e30);
	}
	if (A.HazeLength > 0.0)
	{
		float k = TG_ShellSum(A, A.HazeHalf, i) * A.SunChord / A.HazeLength * -0.693147181;
		logT = logT + float3(k, k, k);
	}
	return float3(exp(max(logT.x, -80.0)), exp(max(logT.y, -80.0)), exp(max(logT.z, -80.0)));
}

// Sunlight transmittance at an atmosphere height (0x1001a100): the table, interpolated between entries.
float3 TG_SunTransmittance(TGWorld W, float h)
{
	TGAtmosphere A = W.Atmos;
	if (A.On == 0.0 || A.LutOn == 0.0)
	{
		return float3(1.0, 1.0, 1.0);
	}
	float idx = (h - A.LutBottom) / A.LutStep;
	int i = (int)idx;
	float f = idx - (float)i;
	int n = (int)A.LutCount;
	int i0 = clamp(i, 0, n);
	int i1 = clamp(i + 1, 0, n);
	return lerp(TG_LutEntry(A, i0), TG_LutEntry(A, i1), f);
}

// Glow (0x1001b450): from the angle to the sun, never less than the sun's radius.
float TG_Glow(TGWorld W, float cosAngle, float p, float flag)
{
	float r = W.SunDiameter * 0.008726646;
	float a = max(acos(clamp(cosAngle, -1.0, 1.0)), r);
	float amt = W.Atmos.GlowAmount;
	float x = pow(amt / a, sqrt(p) * W.Atmos.GlowPower);
	if (flag != 0.0)
	{
		float k = amt * 256.0;
		return (1.0 - exp(-x / k)) * k;
	}
	return 1.0 - exp(-x);
}

// One march step (0x1001a350): red light decay, blue in-scatter, then haze, at the step's mean height.
float3 TG_AtmosStep(TGWorld W, Texture2D CloudTex, TGSunInfo S, float3 colour, float3 p0, float3 p1, float stepLen,
                    float glow, float lit)
{
	TGAtmosphere A = W.Atmos;
	float h0 = TG_AtmosHeight(W, p0);
	float h1 = TG_AtmosHeight(W, p1);
	if (h0 > A.Top && h1 > A.Top)
	{
		return colour;
	}
	float hm = 0.5 * (h0 + h1);
	float3 sun = W.SunColour * TG_SunTransmittance(W, hm) * (TG_CloudSunFactor(W, CloudTex, S, p0, h0, p1, h1) * lit);
	float3 ambTot = W.AmbientSun + W.Ambient * 2.0 + W.AmbientUp + W.AmbientAway;
	if (A.RedLength > 0.0)
	{
		float x = max(hm / A.RedHalf, -64.0);
		if (x < 6.0)
		{
			float d = (exp2(-x) - 0.015625) * stepLen / A.RedLength;
			colour = colour * float3(pow(A.RedColour.x, d), pow(A.RedColour.y, d), pow(A.RedColour.z, d));
		}
	}
	if (A.BlueLength > 0.0)
	{
		float x = max(hm / A.BlueHalf, -64.0);
		if (x < 6.0)
		{
			float d = (exp2(-x) - 0.015625) * stepLen / A.BlueLength;
			colour = colour + (sun + ambTot) * A.BlueColour * d;
		}
	}
	if (A.HazeLength > 0.0)
	{
		float x = max(hm / A.HazeHalf, -64.0);
		if (x < 6.0)
		{
			float d = (exp2(-x) - 0.015625) * stepLen / A.HazeLength;
			colour = lerp(colour, (sun * glow + ambTot) * A.HazeColour, TG_OneMinusExp2Neg(d));
		}
	}
	return colour;
}

// March from the far end p1 to the near end p0 in fixed steps (0x1001a730), the first step being the
// leftover partial one at the far end.
float3 TG_AtmosMarch(TGWorld W, Texture2D CloudTex, TGSunInfo S, float3 p0, float3 p1, float glow, float lit, float3 colour)
{
	float3 d = p1 - p0;
	float len = length(d);
	if (len < 0.0001)
	{
		return colour;
	}
	float stepLen = max(W.Atmos.Step, len / (float)TG_MAX_ATMOS_STEPS);
	float f = len / stepLen;
	int n = (int)floor(f);
	float3 stepVec = d / f;
	colour = TG_AtmosStep(W, CloudTex, S, colour, p0 + stepVec * (float)n, p1, (f - (float)n) * stepLen, glow, lit);
	TG_LOOP for (int i = n - 1; i >= 0; i--)
	{
		colour = TG_AtmosStep(W, CloudTex, S, colour, p0 + stepVec * (float)i, p0 + stepVec * (float)(i + 1), stepLen, glow, lit);
	}
	return colour;
}

// Atmosphere between the camera side p0 and a far point p1 (0x1001aad0). Terragen splits the segment where
// it crosses the terrain grid's edges; that only matters when both ends are outside the grid. Atmospheric
// shadows (the lit < 1 runs inside the grid) are not modelled; Terragen skips them too whenever the segment
// has fewer than two crossings, which includes every camera inside the grid.
float3 TG_Atmosphere(TGWorld W, Texture2D CloudTex, TGSunInfo S, float3 p0, float3 p1, float glow, float3 colour)
{
	if (W.Atmos.On == 0.0)
	{
		return colour;
	}
	float n = (float)W.Terrain.Cells;
	float dx = p1.x - p0.x;
	float dy = p1.y - p0.y;
	float c0 = -1.0;
	float c1 = -1.0;
	float c2 = -1.0;
	float c3 = -1.0;
	if (abs(dx) > 0.0001)
	{
		c0 = -p0.x * (dy / dx) + p0.y + 0.0001;
		if (c0 >= n + 0.0002) { c0 = -c0; }
		c1 = (n - p0.x) * (dy / dx) + p0.y + 0.0001;
		if (c1 >= n + 0.0002) { c1 = -c1; }
	}
	if (abs(dy) > 0.0001)
	{
		c2 = -p0.y * (dx / dy) + p0.x + 0.0001;
		if (c2 >= n + 0.0002) { c2 = -c2; }
		c3 = (n - p0.y) * (dx / dy) + p0.x + 0.0001;
		if (c3 >= n + 0.0002) { c3 = -c3; }
	}
	float lo = 1.0;
	float hi = 0.0;
	if (c0 >= 0.0) { float f = -p0.x / dx; if (f < 1.0) { lo = f; } if (f > 0.0) { hi = f; } }
	if (c1 >= 0.0) { float f = (n - p0.x) / dx; lo = min(lo, f); hi = max(hi, f); }
	if (c2 >= 0.0) { float f = -p0.y / dy; lo = min(lo, f); hi = max(hi, f); }
	if (c3 >= 0.0) { float f = (n - p0.y) / dy; lo = min(lo, f); hi = max(hi, f); }
	lo = max(lo, 0.0);
	hi = min(hi, 1.0);
	// Far to near: [hi, 1], [lo, hi], [0, lo]; one march call in a loop keeps the shader small.
	bool split = hi > lo;
	float3 pe = lerp(p0, p1, lo);
	float3 px = lerp(p0, p1, hi);
	TG_LOOP for (int k = 0; k < 3; k++)
	{
		bool use = split ? (k == 0 ? hi < 1.0 : (k == 1 ? true : lo > 0.0)) : k == 1;
		if (use)
		{
			float3 a = split ? (k == 0 ? px : (k == 1 ? pe : p0)) : p0;
			float3 b = split ? (k == 0 ? p1 : (k == 1 ? px : pe)) : p1;
			colour = TG_AtmosMarch(W, CloudTex, S, a, b, glow, 1.0, colour);
		}
	}
	return colour;
}

// ---------------------------------------------------------------- sky

// Sky dome point (0x1001d430): sun disc, the atmosphere above the cloud layer, the cloud, then the atmosphere
// from the camera. dome is the point on the dome sphere, (u, v) its cloud-map coordinates, footprint the
// pixel's size in map cells. sunDisc = 0 leaves the disc out, as the water reflection (0x10035fd0) does.
float3 TG_ShadeSky(TGWorld W, Texture2D CloudTex, TGSunInfo S, float3 cam, float3 dome, float u, float v, float footprint,
                   float sunDisc)
{
	float3 d = dome - cam;
	float3 dn = normalize(d);
	float cosA = dot(dn, S.Dir);
	float glow = TG_Glow(W, cosA, 1.0, 1.0);
	float3 colour = float3(0.0, 0.0, 0.0);

	float r = W.SunDiameter * 0.008726646;
	if (r > 0.0 && sunDisc != 0.0)
	{
		float a = acos(clamp(cosA, -1.0, 1.0));
		float f = 1.0 / (r * r);
		if (a > r)
		{
			float k = 1.0 + (a / r - 1.0) * W.Sky.Corona;
			f = W.Sky.Corona > 0.0 ? f / (k * k) : 0.0;
		}
		colour = W.SunColour * (f * 256.0);
	}

	float ext = (W.Atmos.Top - W.CloudAltitude) / (W.CloudAltitude - cam.z);
	if (ext > 0.0)
	{
		colour = TG_Atmosphere(W, CloudTex, S, dome, dome + d * ext, glow, colour);
	}

	// Terragen backs the start up by -dz / cell size in z (kept inside the slab) and by the matching amount
	// along the ray in map cells, mixing units as it does.
	float startZ = clamp(-dn.z / W.Sky.CloudCell, -W.CloudDepth * 0.5, W.CloudDepth * 0.5);
	float su = dn.z != 0.0 ? u + dn.x / dn.z * startZ : u;
	float sv = dn.z != 0.0 ? v + dn.y / dn.z * startZ : v;
	float tau = 0.0;
	float light = 0.0;
	float marched = W.Sky.CloudMethod != 0.0 ? 1.0 : 0.0;
	float slant = 1.0;
	TGCloudMarch view;
	view.Tau = 0.0;
	view.Hit = float3(0.0, 0.0, 0.0);
	view.HasHit = 0.0;
	float3 dir2 = float3(S.Dir.x - dn.x, S.Dir.y - dn.y, S.Dir.z);
	if (marched == 0.0)
	{
		float above = W.CloudAltitude - cam.z;
		slant = sqrt((dn.y / above) * (dn.y / above) + (dn.x / above) * (dn.x / above) + 1.0);
		float c = max(TG_CloudDensity(W, CloudTex, u, v, 1.0 / footprint) + W.Sky.CloudBias, 0.0);
		tau = sqrt(c * 0.00390625) * W.Sky.CloudContrast * c * slant * W.CloudDepth;
	}
	float transmit = pow(0.99, tau);
	float glow2 = TG_Glow(W, cosA, transmit, 1.0);
	// Marched: the view march (k = 0), then the light march from where it first met cloud. Map method: only
	// the light march. One march call in a loop keeps the shader small.
	TG_LOOP for (int k = 0; k < 2; k++)
	{
		bool run = k == 0 ? marched != 0.0 : (marched == 0.0 || view.HasHit != 0.0);
		if (run)
		{
			float3 mp = k == 1 && marched != 0.0 ? view.Hit : float3(su, sv, startZ);
			float3 md = k == 0 ? dn : (marched != 0.0 ? S.Dir : dir2);
			float mSteps = k == 0 || marched != 0.0 ? W.Sky.CloudStepsMax : W.Sky.CloudSteps;
			float mLimit = k == 0 ? min(W.Sky.CloudStepsMax, W.Sky.CloudNoiseLimit / footprint) : (marched != 0.0 ? W.Sky.CloudSteps : 0.0);
			TGCloudMarch m = TG_CloudMarch(W, CloudTex, mp.x, mp.y, mp.z, footprint, md, mSteps, mLimit, marched);
			if (k == 0)
			{
				view = m;
				tau = m.Tau;
				transmit = pow(0.99, tau);
				glow2 = TG_Glow(W, cosA, transmit, 1.0);
			}
			else if (marched != 0.0)
			{
				light = pow(0.99, m.Tau * W.Sky.CloudDarkness) * glow2;
			}
			else
			{
				light = pow(0.99, m.Tau * slant / sqrt(dir2.x * dir2.x + dir2.y * dir2.y + 1.0) * W.Sky.CloudDarkness);
			}
		}
	}
	float3 sunT = TG_SunTransmittance(W, W.CloudAltitude) *
	              TG_CloudSunFactor(W, CloudTex, S, dome, W.CloudAltitude, dome, W.CloudAltitude);
	float3 ambSum = W.Ambient * 2.0 + W.AmbientUp + W.AmbientAway;
	float3 cloud = (W.AmbientSun * light + sunT * W.SunColour * (glow2 * light) + ambSum) * W.Atmos.HazeColour;
	colour = lerp(colour, cloud, 1.0 - transmit);

	return TG_Atmosphere(W, CloudTex, S, cam, dome, glow, colour);
}

// Where a ray (D normalised) leaves the dome sphere (0x1001e0d0), which is centred under the grid centre with
// radius 32 * terrain size and its top at the cloud altitude. Returns the point and, in w, the distance along
// the ray, or w = -1 for no hit.
float4 TG_DomeHit(TGWorld W, float3 O, float3 D)
{
	float R = W.Sky.DomeRadius;
	float3 C = float3((float)W.Terrain.Cells * 0.5, (float)W.Terrain.Cells * 0.5, W.CloudAltitude - R);
	float3 oc = O - C;
	float b = dot(oc, D);
	float c = dot(oc, oc) - R * R;
	float disc = b * b - c;
	float t = disc < 0.0 ? -1.0 : -b + sqrt(disc);
	if (t <= 0.0)
	{
		return float4(O.x, O.y, O.z, -1.0);
	}
	float3 P = O + D * t;
	return float4(P.x, P.y, P.z, t);
}

// The sky seen along a ray that hit no terrain: the dome (TG_DomeHit), which covers the cloud map's extent.
// The cloud footprint follows from PixelAngle, or is fixedFootprint (map cells) when that is positive.
// Returns rgb and, in w, 1 if the dome was hit.
float4 TG_SkyDome(TGWorld W, Texture2D CloudTex, TGSunInfo S, float3 O, float3 D, float PixelAngle, float fixedFootprint,
                  float sunDisc)
{
	float4 hit = TG_DomeHit(W, O, D);
	if (hit.w < 0.0)
	{
		return float4(W.BackgroundColour.x, W.BackgroundColour.y, W.BackgroundColour.z, 0.0);
	}
	float t = hit.w;
	float3 P = float3(hit.x, hit.y, hit.z);
	float margin = (W.Sky.CloudExtent - (float)W.Terrain.Cells) * 0.5;
	float u = (P.x + margin) / W.Sky.CloudCell;
	float v = (P.y + margin) / W.Sky.CloudCell;
	if (u < 0.0 || v < 0.0 || u > W.Sky.CloudN || v > W.Sky.CloudN)
	{
		return float4(W.BackgroundColour.x, W.BackgroundColour.y, W.BackgroundColour.z, 0.0);
	}
	float footprint = fixedFootprint > 0.0 ? fixedFootprint : max(t * PixelAngle / max(W.Detail, 0.01) / W.Sky.CloudCell, 0.001);
	float3 sky = TG_ShadeSky(W, CloudTex, S, O, P, u, v, footprint, sunDisc);
	return float4(sky.x, sky.y, sky.z, 1.0);
}

float4 TG_SkyRay(TGWorld W, Texture2D CloudTex, TGSunInfo S, float3 O, float3 D, float PixelAngle)
{
	return TG_SkyDome(W, CloudTex, S, O, D, PixelAngle, 0.0, 1.0);
}

// ---------------------------------------------------------------- tone curve

// Terragen's display conversion (RGBm 0x10028aa0, buffer pass 0x10028ea0), from linear (1.0 ~ white)
// to display 0..1. Modes match the world file's EXME.
float TG_ToneChannel(float x, int mode, float gamma)
{
	float invGamma = 1.0 / gamma;
	if (x <= 0.0)
	{
		return 0.0;
	}
	if (mode == 0)
	{
		return saturate(pow(x, invGamma));
	}
	if (x * 256.0 > 1023.0)
	{
		return 1.0;
	}
	if (mode == 1)
	{
		return pow(1.0 - exp(-1.9 * x), invGamma);
	}
	return pow(sqrt(1.0 - exp(-1.38 * x * x)), invGamma);
}

float3 TG_ToneMap(TGWorld W, float3 c)
{
	c = c * W.Exposure;
	return float3(TG_ToneChannel(c.x, W.ToneMode, W.Gamma), TG_ToneChannel(c.y, W.ToneMode, W.Gamma), TG_ToneChannel(c.z, W.ToneMode, W.Gamma));
}

// ---------------------------------------------------------------- visibility

// Exact intersection with one cell's two triangles over the ray interval [t0, t1]; returns -1 for no hit.
float TG_CellHit(Texture2D HeightTex, TGTerrain T, int ix, int iy, float3 O, float3 D, float t0, float t1)
{
	float h00 = TG_GridHeight(HeightTex, T, ix, iy);
	float h10 = TG_GridHeight(HeightTex, T, ix + 1, iy);
	float h01 = TG_GridHeight(HeightTex, T, ix, iy + 1);
	float h11 = TG_GridHeight(HeightTex, T, ix + 1, iy + 1);
	float cx = (float)ix;
	float cy = (float)iy;
	// The diagonal fx + fy = 1 splits the interval in two; each part lies on one triangle's plane.
	float s0 = (O.x - cx) + (O.y - cy);
	float s1 = D.x + D.y;
	float tSplit = abs(s1) > 1e-12 ? (1.0 - s0) / s1 : -1.0;
	float tA = t0;
	TG_LOOP for (int part = 0; part < 2; part++)
	{
		float tB = t1;
		if (part == 0 && tSplit > t0 && tSplit < t1)
		{
			tB = tSplit;
		}
		float tm = 0.5 * (tA + tB);
		bool upper = (s0 + s1 * tm) > 1.0;
		float gA = 0.0;
		float gB = 0.0;
		TG_LOOP for (int e = 0; e < 2; e++)
		{
			float t = e == 0 ? tA : tB;
			float fx = O.x + D.x * t - cx;
			float fy = O.y + D.y * t - cy;
			float hs = upper ? (1.0 - fy) * (h10 - h11) + (1.0 - fx) * (h01 - h11) + h11
			                 : h00 + (h10 - h00) * fx + (h01 - h00) * fy;
			float g = O.z + D.z * t - hs;
			if (e == 0) { gA = g; } else { gB = g; }
		}
		if (gA <= 0.0)
		{
			return tA;
		}
		if (gB <= 0.0)
		{
			return tA + (tB - tA) * gA / (gA - gB);
		}
		if (tB >= t1)
		{
			break;
		}
		tA = tB;
	}
	return -1.0;
}

// Walk the cells the ray crosses (2D DDA) and return the first terrain or water hit.
TGHit TG_Trace(TGWorld W, Texture2D HeightTex, float3 O, float3 D, float tStart)
{
	TGTerrain T = W.Terrain;
	TGHit hit;
	hit.Kind = 0;
	hit.T = -1.0;
	hit.P = O;

	float n = (float)T.Cells;
	float zLow = min(T.MinHeight, W.WaterPresent != 0.0 ? W.WaterLevel : T.MinHeight) - 0.01;
	float zHigh = max(T.MaxHeight, W.WaterPresent != 0.0 ? W.WaterLevel : T.MaxHeight) + 0.01;
	float t0 = tStart;
	float t1 = 1e30;
	// Clip the ray to the terrain's bounding box.
	float3 lo = float3(0.0, 0.0, zLow);
	float3 hi = float3(n, n, zHigh);
	TG_LOOP for (int axis = 0; axis < 3; axis++)
	{
		float o = axis == 0 ? O.x : (axis == 1 ? O.y : O.z);
		float dd = axis == 0 ? D.x : (axis == 1 ? D.y : D.z);
		float l = axis == 0 ? lo.x : (axis == 1 ? lo.y : lo.z);
		float h = axis == 0 ? hi.x : (axis == 1 ? hi.y : hi.z);
		if (abs(dd) < 1e-12)
		{
			if (o < l || o > h) { return hit; }
		}
		else
		{
			float ta = (l - o) / dd;
			float tb = (h - o) / dd;
			t0 = max(t0, min(ta, tb));
			t1 = min(t1, max(ta, tb));
		}
	}
	if (t1 <= t0)
	{
		return hit;
	}

	// Water is a flat plane over the whole grid; the first of water and terrain wins.
	float tWater = 1e30;
	if (W.WaterPresent != 0.0 && D.z < 0.0 && O.z > W.WaterLevel)
	{
		tWater = (W.WaterLevel - O.z) / D.z;
	}
	float tEnd = min(t1, tWater);

	float3 P = O + D * t0;
	int ix = clamp((int)floor(P.x), 0, T.Cells - 1);
	int iy = clamp((int)floor(P.y), 0, T.Cells - 1);
	int stepX = D.x >= 0.0 ? 1 : -1;
	int stepY = D.y >= 0.0 ? 1 : -1;
	float tDeltaX = abs(D.x) > 1e-12 ? abs(1.0 / D.x) : 1e30;
	float tDeltaY = abs(D.y) > 1e-12 ? abs(1.0 / D.y) : 1e30;
	float tNextX = abs(D.x) > 1e-12 ? ((float)(ix + (stepX > 0 ? 1 : 0)) - O.x) / D.x : 1e30;
	float tNextY = abs(D.y) > 1e-12 ? ((float)(iy + (stepY > 0 ? 1 : 0)) - O.y) / D.y : 1e30;
	float tCur = t0;
	TG_LOOP for (int i = 0; i < 4 * T.Cells + 4; i++)
	{
		float tExit = min(min(tNextX, tNextY), tEnd);
		float th = TG_CellHit(HeightTex, T, ix, iy, O, D, tCur, tExit);
		if (th >= 0.0)
		{
			hit.Kind = 1;
			hit.T = th;
			hit.P = O + D * th;
			return hit;
		}
		if (tExit >= tEnd)
		{
			break;
		}
		tCur = tExit;
		if (tNextX < tNextY)
		{
			ix += stepX;
			tNextX += tDeltaX;
		}
		else
		{
			iy += stepY;
			tNextY += tDeltaY;
		}
		if (ix < 0 || iy < 0 || ix >= T.Cells || iy >= T.Cells)
		{
			break;
		}
	}
	if (tWater <= t1)
	{
		hit.Kind = 2;
		hit.T = tWater;
		hit.P = O + D * tWater;
	}
	return hit;
}

// ---------------------------------------------------------------- camera and atlas

// Terragen's camera (0x1002c910, ReceiveRender): focal length = zoom * width / 2, heading measured from
// +y towards +x, pitch up positive. Pixel is the pixel centre, row 0 at the top.
float3 TG_CameraRay(float HeadingDeg, float PitchDeg, float Zoom, float2 Pixel, float2 ImageSize)
{
	float h = HeadingDeg * TG_DEG;
	float p = PitchDeg * TG_DEG;
	float3 F = float3(sin(h) * cos(p), cos(h) * cos(p), sin(p));
	float3 Rt = float3(cos(h), -sin(h), 0.0);
	float3 U = cross(Rt, F);
	float focal = Zoom * ImageSize.x * 0.5;
	float sx = (Pixel.x - ImageSize.x * 0.5) / focal;
	float sy = (ImageSize.y * 0.5 - Pixel.y) / focal;
	return F + Rt * sx + U * sy;
}

// The skybox cross atlas, exactly the layout of Scripts/GenerateSkyboxTexture.py. With face size S it is
// 4S x 4S: Back (0, 1.5S), Left (S, 1.5S), Front (2S, 1.5S), Right (3S, 1.5S), mirrored left-right; Up (S, 0.5S)
// and Down (S, 2.5S), mirrored top-bottom. Faces look at AtlasHeading + 0/90/180/270 degrees (Front, Left,
// Back, Right); Up and Down use +270, like GenSkyboxAnimation.tgs.
struct TGAtlasFace
{
	float HeadingOffset;
	float Pitch;
	float2 Origin;    // top-left corner, in face sizes
	bool MirrorX;
	bool MirrorY;
};

// Face order: 0 Front, 1 Left, 2 Back, 3 Right, 4 Up, 5 Down.
TGAtlasFace TG_GetAtlasFace(int i)
{
	TGAtlasFace F;
	F.HeadingOffset = i < 4 ? 90.0 * (float)i : 270.0;
	F.Pitch = i == 4 ? 90.0 : (i == 5 ? -90.0 : 0.0);
	F.Origin = i == 0 ? float2(2.0, 1.5) : (i == 1 ? float2(1.0, 1.5) : (i == 2 ? float2(0.0, 1.5) :
	           (i == 3 ? float2(3.0, 1.5) : (i == 4 ? float2(1.0, 0.5) : float2(1.0, 2.5)))));
	F.MirrorX = i < 4;
	F.MirrorY = i >= 4;
	return F;
}

// Which face an atlas pixel position (in pixels, 0..4S) falls in, or -1.
int TG_AtlasFaceAt(float2 p, float FaceSize)
{
	float fx = p.x / FaceSize;
	float fy = p.y / FaceSize;
	if (fy >= 1.5 && fy < 2.5)
	{
		return fx < 1.0 ? 2 : (fx < 2.0 ? 1 : (fx < 3.0 ? 0 : 3));
	}
	if (fx >= 1.0 && fx < 2.0)
	{
		if (fy >= 0.5 && fy < 1.5) { return 4; }
		if (fy >= 2.5 && fy < 3.5) { return 5; }
	}
	return -1;
}

// Terragen view direction for an atlas UV (0..1); w = 0 outside the six faces.
float4 TG_AtlasDirection(float2 UV, float AtlasHeading, float FaceSize)
{
	float2 p = UV * (4.0 * FaceSize);
	int face = TG_AtlasFaceAt(p, FaceSize);
	if (face < 0)
	{
		return float4(0.0, 0.0, 0.0, 0.0);
	}
	TGAtlasFace F = TG_GetAtlasFace(face);
	float lx = p.x - F.Origin.x * FaceSize;
	float ly = p.y - F.Origin.y * FaceSize;
	if (F.MirrorX) { lx = FaceSize - lx; }
	if (F.MirrorY) { ly = FaceSize - ly; }
	float3 d = TG_CameraRay(AtlasHeading + F.HeadingOffset, F.Pitch, 1.0, float2(lx, ly), float2(FaceSize, FaceSize));
	return float4(d.x, d.y, d.z, 1.0);
}

// Atlas UV for a Terragen view direction; the inverse of TG_AtlasDirection. Face-local coordinates are kept
// half a pixel inside each face so bilinear filtering never reads the empty atlas area.
float2 TG_AtlasUV(float3 Dir, float AtlasHeading, float FaceSize)
{
	int best = 0;
	float bestDot = -2.0;
	float3 bestF = float3(0.0, 1.0, 0.0);
	float3 bestR = float3(1.0, 0.0, 0.0);
	float3 bestU = float3(0.0, 0.0, 1.0);
	float3 d = normalize(Dir);
	TG_LOOP for (int i = 0; i < 6; i++)
	{
		TGAtlasFace F = TG_GetAtlasFace(i);
		float h = (AtlasHeading + F.HeadingOffset) * TG_DEG;
		float pt = F.Pitch * TG_DEG;
		float3 fw = float3(sin(h) * cos(pt), cos(h) * cos(pt), sin(pt));
		float k = dot(d, fw);
		if (k > bestDot)
		{
			bestDot = k;
			best = i;
			bestF = fw;
			bestR = float3(cos(h), -sin(h), 0.0);
			bestU = cross(bestR, fw);
		}
	}
	TGAtlasFace B = TG_GetAtlasFace(best);
	float sx = dot(d, bestR) / bestDot;
	float sy = dot(d, bestU) / bestDot;
	float halfSize = FaceSize * 0.5;
	float lx = clamp(sx * halfSize + halfSize, 0.5, FaceSize - 0.5);
	float ly = clamp(halfSize - sy * halfSize, 0.5, FaceSize - 0.5);
	if (B.MirrorX) { lx = FaceSize - lx; }
	if (B.MirrorY) { ly = FaceSize - ly; }
	return float2((B.Origin.x * FaceSize + lx) / (4.0 * FaceSize), (B.Origin.y * FaceSize + ly) / (4.0 * FaceSize));
}

// Bilinear lookup of an atlas by direction with Load, so no sampler is needed (the atlas is 4 * FaceSize wide).
float3 TG_AtlasLookup(Texture2D Atlas, float3 Dir, float AtlasHeading, float FaceSize)
{
	float2 uv = TG_AtlasUV(Dir, AtlasHeading, FaceSize);
	float size = 4.0 * FaceSize;
	float fx = uv.x * size - 0.5;
	float fy = uv.y * size - 0.5;
	float x0 = floor(fx);
	float y0 = floor(fy);
	float ax = fx - x0;
	float ay = fy - y0;
	int ix = (int)x0;
	int iy = (int)y0;
	float4 a = Atlas.Load(int3(ix, iy, 0));
	float4 b = Atlas.Load(int3(ix + 1, iy, 0));
	float4 c = Atlas.Load(int3(ix, iy + 1, 0));
	float4 d = Atlas.Load(int3(ix + 1, iy + 1, 0));
	float3 top = lerp(float3(a.x, a.y, a.z), float3(b.x, b.y, b.z), ax);
	float3 bottom = lerp(float3(c.x, c.y, c.z), float3(d.x, d.y, d.z), ax);
	return lerp(top, bottom, ay);
}

// The sphere map (equirectangular), the other atlas layout ATerragenSkybox can draw: U goes once round from
// heading AtlasHeading - 180 (left edge) through AtlasHeading (centre) to AtlasHeading + 180, V from straight up
// (top) to straight down. Every column has the same angular size, so the horizon is equally sharp all round,
// and the only seam (directly behind, at U = 0 / 1) filters across with wrap addressing.
float3 TG_SphereDirection(float2 UV, float AtlasHeading)
{
	float h = (AtlasHeading + UV.x * 360.0 - 180.0) * TG_DEG;
	float p = (90.0 - UV.y * 180.0) * TG_DEG;
	return float3(sin(h) * cos(p), cos(h) * cos(p), sin(p));
}

// The inverse of TG_SphereDirection.
float2 TG_SphereUV(float3 Dir, float AtlasHeading)
{
	float3 d = normalize(Dir);
	float h = atan2(d.x, d.y) / TG_DEG - AtlasHeading + 180.0;
	float u = h / 360.0;
	u = u - floor(u);
	float v = (90.0 - asin(clamp(d.z, -1.0, 1.0)) / TG_DEG) / 180.0;
	return float2(u, v);
}

// ---------------------------------------------------------------- entry points

TGShadeResult TG_EmptyResult(TGWorld W)
{
	TGShadeResult R;
	R.Linear = W.BackgroundColour;
	R.Alpha = 0.0;
	R.Albedo = float3(0.0, 0.0, 0.0);
	R.SunTerm = 0.0;
	R.NdotL = 0.0;
	R.NormalZ = 1.0;
	R.Distance = -1.0;
	R.Kind = 0;
	return R;
}

// Sunlight reaching a point: the penetration table at its atmosphere height. The cloud dimming uses the
// atmosphere height too, as Terragen does; with the atmosphere off it keeps the plain height.
float TG_CloudHeight(TGWorld W, float3 P)
{
	return W.Atmos.On != 0.0 ? TG_AtmosHeight(W, P) : P.z;
}

// A lit terrain point (0x1002d620 before its atmosphere call): surface tree, bump, light, soft shadow.
TGShadeResult TG_ShadeTerrain(TGWorld W, Texture2D HeightTex, Texture2D NoiseTex, Texture2D CloudTex, TGSunInfo S, float3 P,
                              float footprint)
{
	TGShadeResult R = TG_EmptyResult(W);
	float x = P.x;
	float y = P.y;
	// Base gradient from the heightfield at +-0.5 cell (0x1002d4e0).
	float2 grad0 = float2(TG_TerrainHeight(HeightTex, W.Terrain, x + 0.5, y) - TG_TerrainHeight(HeightTex, W.Terrain, x - 0.5, y),
	                      TG_TerrainHeight(HeightTex, W.Terrain, x, y + 0.5) - TG_TerrainHeight(HeightTex, W.Terrain, x, y - 0.5));
	TGSurface surf = TG_SurfaceTree(W, HeightTex, NoiseTex, x, y, grad0, footprint);
	float3 N = normalize(float3(-surf.Grad.x, -surf.Grad.y, 1.0));

	float h = TG_TerrainHeight(HeightTex, W.Terrain, x, y);
	float shadow = 0.0;
	if (W.LandShadows != 0.0)
	{
		shadow = TG_SunShadow(HeightTex, W.Terrain, S, x, y, h);
	}
	float smoothShadow = shadow * shadow * (3.0 - 2.0 * shadow);
	float3 at = float3(x, y, h);
	float hc = TG_CloudHeight(W, at);
	float sunFactor = TG_CloudSunFactor(W, CloudTex, S, at, hc, at, hc) * (1.0 - smoothShadow) * max(dot(N, S.Dir), 0.0);
	float3 sunT = TG_SunTransmittance(W, TG_AtmosHeight(W, at));

	R.Alpha = 1.0;
	R.Kind = 1;
	R.Albedo = surf.Colour;
	R.SunTerm = sunFactor;
	R.NdotL = dot(N, S.Dir);
	R.NormalZ = N.z;
	R.Linear = surf.Colour * TG_Light(W, S, N, W.SunColour * sunT * sunFactor);
	return R;
}

// Water surface height with Terragen's waves (0x10034ce0): turbulence on noise3 over WaterWaveSize, with
// octaves up to 2 * WaterWaveSize / q for heights sampled q apart.
float TG_WaterHeight(TGWorld W, float x, float y, float q)
{
	float S = W.WaterWaveSize;
	if (S <= 0.0)
	{
		return W.WaterLevel;
	}
	float limit = max(2.0 / q * S, 1.0);
	return W.WaterLevel - TG_Turbulence3(x / S, y / S, W.WaterWaveTime, limit) * W.WaterWaveAmp;
}

// One water sample (0x10035020; 0x10035dc0 averages WAQU jittered ones per micro-polygon, here there is one
// per pixel). The wave normal comes from heights a footprint apart. The view ray reflects off it (z kept
// upwards) into the terrain or the sky without the sun disc, plus a sun lobe RSLB * e^(1 - (angle/RSLS)^2) /
// RSLS^2 (0x10034f90); the reflectivity runs from WaterReflMin to WaterReflMax as (1 - |cos|)^(1 / RCRV). The
// rest is the refracted view of the bed (0x10036280), fading to the lit water colour with depth. Not ported:
// surf (SFDN and the rest) and the wave-strength pattern (WVAR). WaterShading = 0 keeps the flat lit plane of
// the pre-sky renderer.
// TG_WaterSurface does all but the traces and the terrain and sky shading, which TG_ShadeRay does so that each
// is compiled once.
struct TGWater
{
	TGShadeResult R;    // the flat lit plane; the whole answer when WaterShading is 0
	float3 Lobe;        // the reflected sun, already weighted
	float3 Body;        // the lit water colour
	float F;            // reflection curve: the bed and body get 1 - F
	float ReflW;        // reflectivity; 0 = nothing reflected
	float3 ReflFrom;
	float3 ReflDir;
	float3 RefrFrom;
	float3 RefrDir;
	float Footprint;
};

TGWater TG_EmptyWater(TGWorld W, float3 P)
{
	TGWater Wt;
	Wt.R = TG_EmptyResult(W);
	Wt.Lobe = float3(0.0, 0.0, 0.0);
	Wt.Body = float3(0.0, 0.0, 0.0);
	Wt.F = 0.0;
	Wt.ReflW = 0.0;
	Wt.ReflFrom = P;
	Wt.ReflDir = float3(0.0, 0.0, 1.0);
	Wt.RefrFrom = P;
	Wt.RefrDir = float3(0.0, 0.0, -1.0);
	Wt.Footprint = 1e-4;
	return Wt;
}

TGWater TG_WaterSurface(TGWorld W, Texture2D HeightTex, Texture2D CloudTex, TGSunInfo S, float3 O, float3 P, float footprint)
{
	TGWater Wt;
	TGShadeResult R = TG_EmptyResult(W);
	float3 N = float3(0.0, 0.0, 1.0);
	float hc = TG_CloudHeight(W, P);
	float cloudSun = TG_CloudSunFactor(W, CloudTex, S, P, hc, P, hc);
	float sunFactor = cloudSun * max(dot(N, S.Dir), 0.0);
	float3 sunT = TG_SunTransmittance(W, TG_AtmosHeight(W, P));
	R.Alpha = 1.0;
	R.Kind = 2;
	R.Albedo = W.WaterColour;
	R.SunTerm = sunFactor;
	R.NdotL = S.Dir.z;
	R.Linear = W.WaterColour * TG_Light(W, S, N, W.SunColour * sunT * sunFactor);
	Wt.Lobe = float3(0.0, 0.0, 0.0);
	Wt.Body = R.Linear;
	Wt.F = 0.0;
	Wt.ReflW = 0.0;
	Wt.ReflFrom = P;
	Wt.ReflDir = float3(0.0, 0.0, 1.0);
	Wt.RefrFrom = P;
	Wt.RefrDir = float3(0.0, 0.0, -1.0);
	Wt.Footprint = max(footprint, 1e-4);
	if (W.WaterShading != 0.0)
	{
		// The terrain's shadow on the water (0x10035dc0), smoothstepped like the land's.
		float lit = 1.0;
		if (W.LandShadows != 0.0)
		{
			float sh = 1.0 - TG_SunShadow(HeightTex, W.Terrain, S, P.x, P.y, W.WaterLevel);
			lit = sh * sh * (3.0 - 2.0 * sh);
		}
		float3 sun = W.SunColour * sunT * (cloudSun * lit);
		float q = Wt.Footprint;
		float h0 = 0.0;
		float h1 = 0.0;
		float h2 = 0.0;
		TG_LOOP for (int k = 0; k < 3; k++)
		{
			float h = TG_WaterHeight(W, P.x + (k == 1 ? q : 0.0), P.y + (k == 2 ? q : 0.0), q);
			if (k == 0) { h0 = h; } else if (k == 1) { h1 = h; } else { h2 = h; }
		}
		N = normalize(float3(-(h1 - h0) * q, -(h2 - h0) * q, q * q));
#if TG_PROFILE_NO_WAVES
		N = float3(0.0, 0.0, 1.0);
#endif
		float3 V = normalize(O - float3(P.x, P.y, h0));
		float e = exp(-W.WaterViscosity);
		float c = e * dot(N, V) + (1.0 - e);
		Wt.F = pow(saturate(1.0 - abs(c)), 1.0 / max(W.WaterReflCurve, 0.01));
		Wt.ReflW = lerp(W.WaterReflMin, W.WaterReflMax, Wt.F);
		Wt.Body = W.WaterColour * TG_Light(W, S, N, sun * max(dot(N, S.Dir), 0.0));
		float3 Rd = N * (2.0 * c) - V;
		Rd = normalize(float3(Rd.x, Rd.y, abs(Rd.z)));
		float a = acos(clamp(dot(Rd, S.Dir), -1.0, 1.0)) / W.WaterSunWidth;
		Wt.Lobe = sun * (Wt.ReflW * W.WaterSunLobe * exp(1.0 - a * a) / (W.WaterSunWidth * W.WaterSunWidth));
		Wt.ReflFrom = float3(P.x, P.y, max(h0, W.WaterLevel) + 0.001);
		Wt.ReflDir = Rd;
		float eta = (1.0 - c * c) * 0.7692308;
		float s = sqrt(max(1.0 - eta * eta, 0.0));
		Wt.RefrFrom = float3(P.x, P.y, min(h0, W.WaterLevel) - 0.001);
		Wt.RefrDir = normalize(-(N * (c * s)) - (V - N * c) * eta);
		R.NdotL = dot(N, S.Dir);
		R.NormalZ = N.z;
	}
	Wt.R = R;
	return Wt;
}

// Shade one ray. O is in Terragen coordinates, D need not be normalised. PixelAngle is the angle one
// pixel subtends (1 / focal length in pixels); it sets the detail footprint like Terragen's micro-polygon
// size. StartDistance skips terrain closer than that many grid units. CloudTex is the world's cloud map
// (only read when the sky or cloud shadows are on). Rays that hit nothing show the sky, with Alpha 0.
// The expensive parts are each compiled once, which keeps FXC's compile time sane: a ray needs up to three
// traces (the view ray, then for water its reflection and refraction), two terrain shadings (the hit, or the
// reflection's hit and the lake bed) and one sky (a miss, or the reflection's miss).
// SkipSky leaves out the sky of a ray that hits nothing (it returns the background with alpha 0), so the sky
// can be rendered separately at its own resolution and rate (TG_RenderSkyRay); reflections still see the sky.
// With ReflFaceSize > 0, a water reflection that misses the terrain reads the sky from ReflSky, an atlas of
// linear reflection-sky colour (TG_RenderReflectionSkyRay from ReflCameraPos, heading ReflAtlasHeading)
// instead of computing it: the costly part of the water. The atlas holds the sky seen from one point at water
// level, so the lookup aims at the dome point the reflection really meets, which keeps the clouds in place;
// what is left over is the atmosphere along a slightly different path.
TGShadeResult TG_ShadeRayEx(TGWorld W, Texture2D HeightTex, Texture2D NoiseTex, Texture2D CloudTex, float3 O, float3 D, float PixelAngle, float StartDistance, bool SkipSky,
                            Texture2D ReflSky, float3 ReflCameraPos, float ReflAtlasHeading, float ReflFaceSize)
{
	D = normalize(D);
	TGShadeResult R = TG_EmptyResult(W);
	TGSunInfo S = TG_MakeSun(W);
	float3 zero = float3(0.0, 0.0, 0.0);
	float3 colour = zero;
	TGHit hit;
	hit.Kind = 0;
	hit.T = -1.0;
	hit.P = O;
	TGWater wt = TG_EmptyWater(W, O);
	// Terrain to shade: slot 0 is the hit or the reflection's hit (seen through the atmosphere from the water),
	// slot 1 the lake bed.
	float3 p0 = O;
	float fp0 = 1e-4;
	float3 w0 = zero;
	float atmos0 = 0.0;
	float3 p1 = O;
	float fp1 = 1e-4;
	float3 w1 = zero;
	float3 skyO = O;
	float3 skyD = D;
	float skyFp = 0.0;
	float skySun = 1.0;
	float3 skyW = zero;
	float3 rayO = O;
	float3 rayD = D;
	float rayStart = StartDistance;
	int traces = 1;
	TG_LOOP for (int trace = 0; trace < traces; trace++)
	{
		TGHit h = TG_Trace(W, HeightTex, rayO, rayD, rayStart);
		if (trace == 0)
		{
			hit = h;
			if (h.Kind == 0)
			{
				if (W.Sky.On != 0.0 && !SkipSky)
				{
					skyW = float3(1.0, 1.0, 1.0);
				}
			}
			else
			{
				float footprint = max(h.T * PixelAngle / max(W.Detail, 0.01), 1e-4);
				if (h.Kind == 1)
				{
					p0 = h.P;
					fp0 = footprint;
					w0 = float3(1.0, 1.0, 1.0);
				}
				else
				{
					wt = TG_WaterSurface(W, HeightTex, CloudTex, S, O, h.P, footprint);
					colour = W.WaterShading != 0.0 ? wt.Lobe + wt.Body * (1.0 - wt.F) : wt.R.Linear;
					if (W.WaterShading != 0.0)
					{
						traces = TG_PROFILE_WATER_TRACES;
						rayO = wt.ReflFrom;
						rayD = wt.ReflDir;
						rayStart = 0.0;
					}
				}
			}
		}
		else if (trace == 1)
		{
			if (wt.ReflW > 0.0)
			{
				if (h.Kind == 1)
				{
					p0 = h.P;
					fp0 = max((hit.T + h.T) * PixelAngle / max(W.Detail, 0.01), 1e-4);
					w0 = float3(wt.ReflW, wt.ReflW, wt.ReflW);
					atmos0 = 1.0;
				}
				else if (W.Sky.On != 0.0)
				{
					skyO = wt.ReflFrom;
					skyD = wt.ReflDir;
					skyFp = 0.1;
					skySun = 0.0;
					skyW = TG_PROFILE_NO_REFL_SKY ? float3(0.0, 0.0, 0.0) : float3(wt.ReflW, wt.ReflW, wt.ReflW);
				}
			}
			rayO = wt.RefrFrom;
			rayD = wt.RefrDir;
		}
		else if (h.Kind == 1 && h.T < W.WaterMaxDepth && wt.F < 1.0)
		{
			float3 a = float3(1.0 - exp(-W.WaterAbsorb.x * h.T), 1.0 - exp(-W.WaterAbsorb.y * h.T),
			                  1.0 - exp(-W.WaterAbsorb.z * h.T));
			colour = wt.Lobe + wt.Body * a * (1.0 - wt.F);
			p1 = h.P;
			fp1 = wt.Footprint;
			w1 = (float3(1.0, 1.0, 1.0) - a) * (1.0 - wt.F);
		}
	}
	if (hit.Kind == 2)
	{
		R = wt.R;
	}
	TG_LOOP for (int k = 0; k < 2; k++)
	{
		float3 wk = k == 0 ? w0 : w1;
		if (wk.x + wk.y + wk.z > 0.0)
		{
			TGShadeResult t = TG_ShadeTerrain(W, HeightTex, NoiseTex, CloudTex, S, k == 0 ? p0 : p1, k == 0 ? fp0 : fp1);
			float3 c = t.Linear;
			if (k == 0 && atmos0 != 0.0)
			{
				c = TG_Atmosphere(W, CloudTex, S, wt.ReflFrom, p0, TG_Glow(W, dot(wt.ReflDir, S.Dir), 1.0, W.Atmos.GlowFlag), c);
			}
			if (hit.Kind == 1)
			{
				R = t;
			}
			colour = colour + c * wk;
		}
	}
	if (skyW.x + skyW.y + skyW.z > 0.0)
	{
		// skySun is 0 only for a reflection's sky.
		if (skySun == 0.0 && ReflFaceSize > 0.0)
		{
			float4 q = TG_DomeHit(W, skyO, normalize(skyD));
			float3 look = q.w > 0.0 ? float3(q.x, q.y, q.z) - float3(ReflCameraPos.x, ReflCameraPos.y, W.WaterLevel + 0.001) : skyD;
			colour = colour + TG_AtlasLookup(ReflSky, look, ReflAtlasHeading, ReflFaceSize) * skyW;
		}
		else
		{
			float4 sky = TG_SkyDome(W, CloudTex, S, skyO, skyD, PixelAngle, skyFp, skySun);
			colour = colour + float3(sky.x, sky.y, sky.z) * skyW;
		}
	}
	if (hit.Kind == 0)
	{
		if (W.Sky.On != 0.0 && !SkipSky)
		{
			R.Linear = colour;
		}
	}
	else
	{
		R.Distance = hit.T;
		// Atmosphere between the camera and the point, with the glow towards the sun (0x1002d620).
		R.Linear = TG_Atmosphere(W, CloudTex, S, O, hit.P, TG_Glow(W, dot(D, S.Dir), 1.0, W.Atmos.GlowFlag), colour);
	}
	return R;
}

TGShadeResult TG_ShadeRay(TGWorld W, Texture2D HeightTex, Texture2D NoiseTex, Texture2D CloudTex, float3 O, float3 D, float PixelAngle, float StartDistance)
{
	return TG_ShadeRayEx(W, HeightTex, NoiseTex, CloudTex, O, D, PixelAngle, StartDistance, false, NoiseTex, O, 0.0, 0.0);
}

// The sky a water reflection sees in direction D, as TG_ShadeRayEx computes it exactly: from water level below
// O, without the sun disc (the sun's reflection is the water's own lobe), with Terragen's fixed cloud footprint
// for reflections. Linear colour, for an HDR atlas that TG_ShadeRayEx then reads. (Steep waves can reflect
// downwards, so every direction is rendered.)
float4 TG_RenderReflectionSkyRay(TGWorld W, Texture2D CloudTex, float3 O, float3 D)
{
	if (W.Sky.On == 0.0 || W.WaterPresent == 0.0)
	{
		return float4(0.0, 0.0, 0.0, 1.0);
	}
	float4 sky = TG_SkyDome(W, CloudTex, TG_MakeSun(W), float3(O.x, O.y, W.WaterLevel + 0.001), normalize(D), 0.0, 0.1, 0.0);
	return float4(sky.x, sky.y, sky.z, 1.0);
}

// True when the sky in direction D is never seen from near O: the ray is more than 5 degrees below the horizon
// and reaches the lowest surface (the water plane, or the terrain's lowest point) well inside the grid, so it has
// hit the terrain or the water first. The margin (24 cells) keeps that true for a camera up to a few dozen
// metres away, so a sky atlas drawn from O can still be used after the camera moves. StartDistance must not
// skip past that point.
bool TG_SkyHidden(TGWorld W, float3 O, float3 D, float StartDistance)
{
	D = normalize(D);
	float floorZ = W.WaterPresent != 0.0 ? max(W.WaterLevel, W.Terrain.MinHeight) : W.Terrain.MinHeight;
	if (D.z > -0.0872 || O.z <= floorZ)
	{
		return false;
	}
	float t = (floorZ - O.z) / D.z;
	float x = O.x + D.x * t;
	float y = O.y + D.y * t;
	float m = 24.0;
	float n = (float)W.Terrain.Cells;
	return t >= StartDistance && x > m && y > m && x < n - m && y < n - m;
}

// Only the sky of a ray: what TG_ShadeRay returns for a ray that hits no terrain, tone mapped. With the sky
// off that is the background colour.
float4 TG_RenderSkyRay(TGWorld W, Texture2D CloudTex, float3 O, float3 D, float PixelAngle)
{
	float3 c = W.BackgroundColour;
	if (W.Sky.On != 0.0)
	{
		float4 sky = TG_SkyDome(W, CloudTex, TG_MakeSun(W), O, normalize(D), PixelAngle, 0.0, 1.0);
		c = float3(sky.x, sky.y, sky.z);
	}
	c = TG_ToneMap(W, c);
	return float4(c.x, c.y, c.z, 1.0);
}

// Display colour (Terragen's exposure and tone curve applied) and coverage alpha.
float4 TG_RenderRay(TGWorld W, Texture2D HeightTex, Texture2D NoiseTex, Texture2D CloudTex, float3 O, float3 D, float PixelAngle, float StartDistance)
{
	TGShadeResult R = TG_ShadeRay(W, HeightTex, NoiseTex, CloudTex, O, D, PixelAngle, StartDistance);
	float3 c = TG_ToneMap(W, R.Linear);
	return float4(c.x, c.y, c.z, R.Alpha);
}

#endif // TERRAGEN_USH
